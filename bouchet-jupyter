def cmd_inspect_gpus(args, cfg: Config) -> None:
    nodes = Slurm(SSH(cfg.host)).nodes()
    by_type: dict[str, dict] = {}
    for n in nodes:
        if not n.gpu_type or n.gpu_total == 0:
            continue
        b = by_type.setdefault(n.gpu_type, {"used": 0, "total": 0, "free_nodes": 0,
                                            "node_count": 0, "partitions": set()})
        b["used"]  += n.gpu_alloc
        b["total"] += n.gpu_total
        b["node_count"] += 1
        if n.gpu_alloc < n.gpu_total and n.state in ("IDLE", "MIXED"):
            b["free_nodes"] += 1
        for p in n.partitions:
            b["partitions"].add(p)

    if not by_type:
        print("(no GPUs found)")
        return
    print(f"{'TYPE':<28} {'USED':>5} {'TOTAL':>6} {'FREE':>5} {'NODES_FREE':>11}  PARTITIONS")
    for t in sorted(by_type, key=lambda k: -by_type[k]["total"]):
        b = by_type[t]
        free = b["total"] - b["used"]
        parts = ", ".join(sorted(b["partitions"]))
        print(f"{t:<28} {b['used']:>5} {b['total']:>6} {free:>5} "
              f"{b['free_nodes']}/{b['node_count']:<8}  {parts}")


def cmd_inspect_nodes(args, cfg: Config) -> None:
    nodes = Slurm(SSH(cfg.host)).nodes()
    by_part: dict[str, list[Node]] = {}
    for n in nodes:
        for p in n.partitions:
            if args.partition and p != args.partition:
                continue
            by_part.setdefault(p, []).append(n)
    if not by_part:
        if args.partition:
            die(f"no nodes in partition '{args.partition}'")
        die("(no partitions found)")

    for pname in sorted(by_part):
        ns = by_part[pname]
        cpu_alloc = sum(x.cpu_alloc for x in ns)
        cpu_tot   = sum(x.cpu_tot for x in ns)
        gpu_alloc = sum(x.gpu_alloc for x in ns)
        gpu_tot   = sum(x.gpu_total for x in ns)
        gpu_blurb = f", {gpu_alloc}/{gpu_tot} gpu used" if gpu_tot else ""
        print(f"{pname}  ({len(ns)} nodes{gpu_blurb}, {cpu_alloc}/{cpu_tot} cpu used)")
        for n in sorted(ns, key=lambda x: x.name):
            gpu_col = f"gpu={n.gpu_alloc}/{n.gpu_total}" if n.gpu_total else "gpu=-"
            mem_col = f"mem={fmt_mb(n.alloc_mem_mb)}/{fmt_mb(n.real_mem_mb)}"
            flags   = n.flags or "-"
            print(f"  {n.name:<14} state={n.state:<10} {gpu_col:<10} "
                  f"cpu={n.cpu_alloc}/{n.cpu_tot:<4} {mem_col:<18} flags={flags}")
        print()


def cmd_inspect_wait(args, cfg: Config) -> None:
    ssh = SSH(cfg.host)
    slurm = Slurm(ssh)
    targets: list[tuple[str, str]] = []   # (display_name, job_id)
    if args.job:
        sname = "-"
        for n in Sessions.list_names():
            s = Sessions.load(n)
            if s.get("JOB_ID") == args.job:
                sname = n
                break
        targets.append((sname, args.job))
    else:
        # Default: pending tracked sessions only (intersection).
        my_pd = {row["job_id"]: row for row in slurm.my_pending()}
        for n in Sessions.list_names():
            s = Sessions.load(n)
            jid = s.get("JOB_ID")
            if jid and jid in my_pd:
                targets.append((n, jid))
        if not targets:
            print("(no pending tracked sessions; pass --job ID to query an arbitrary job)")
            return

    # Single cluster-wide pending query → computes queue position locally.
    pending_raw = ssh.run("squeue -h -t PD -o '%i|%Q|%P'", check=False)
    by_part: dict[str, list[int]] = {}        # partition -> sorted desc priorities
    me_lookup: dict[str, tuple[int, str]] = {} # job_id -> (priority, partition)
    for line in pending_raw.splitlines():
        parts = line.split("|")
        if len(parts) < 3:
            continue
        jid_p, prio_s, part = parts[0], parts[1], parts[2]
        try:
            prio = int(prio_s)
        except ValueError:
            continue
        by_part.setdefault(part, []).append(prio)
        me_lookup[jid_p] = (prio, part)

    print(f"{'NAME':<10} {'JOB_ID':<10} {'PARTITION':<12} {'PRIO':<6} "
          f"{'POS':<8} {'REASON':<14} {'START_ESTIMATE':<22} ETA")
    for sname, jid in targets:
        est = slurm.start_estimate(jid)
        if jid in me_lookup:
            my_prio, my_part = me_lookup[jid]
            ahead = sum(1 for p in by_part.get(my_part, []) if p > my_prio)
            total = len(by_part.get(my_part, []))
            pos = f"{ahead + 1}/{total}"
        else:
            pos = "-"
        if not est:
            print(f"{sname:<10} {jid:<10} {'?':<12} {'?':<6} "
                  f"{pos:<8} {'?':<14} {'(no estimate)':<22} -")
            continue
        eta = fmt_eta(est["start"]) if est["start"] != "N/A" else "-"
        print(f"{sname:<10} {jid:<10} {est['partition']:<12} {est['priority']:<6} "
              f"{pos:<8} {est['reason']:<14} {est['start']:<22} {eta}")


# ---------------------------------------------------------------------------
# Main / argparse
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="bouchet-jupyter",
        description="Launch / tear down JupyterLab sessions on Bouchet, and "
                    "inspect cluster state.",
    )
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    sp = sub.add_parser("up", help="submit a job, wait for it, open tunnel + browser",
                        description="Submit a Jupyter job, wait until it lands, "
                                    "open an SSH tunnel and the browser URL.")
    sp.add_argument("--profile", help=f"profile name (default: from config, e.g. gpu/cpu)")
    sp.add_argument("--name", help="session name (default: 'default')")
    sp.add_argument("--port", type=int, help="local port base (auto-bumped if busy)")
    sp.add_argument("--hours", type=float,
                    help="walltime in hours, overrides the profile's time (e.g. --hours 10)")
    sp.set_defaults(fn=cmd_up)

    sp = sub.add_parser("down", help="tear down a session (or all)",
                        description="Cancel the Slurm job and close its tunnel.")
    sp.add_argument("--name", help="session name (default: 'default')")
    sp.add_argument("--all", action="store_true", help="tear down every tracked session")
    sp.set_defaults(fn=cmd_down)

    sp = sub.add_parser("list", help="list tracked sessions",
                        description="One row per session with live Slurm state.")
    sp.add_argument("--no-sync", action="store_true",
                    help="skip the cluster check and read cached local state only")
    sp.set_defaults(fn=cmd_list)

    sp = sub.add_parser("status", help="show one session, or list all if no name",
                        description="With --name: full session payload + live job state. "
                                    "Without: same output as `list`.")
    sp.add_argument("--name")
    sp.add_argument("--no-sync", action="store_true",
                    help="skip the cluster check and read cached local state only")
    sp.set_defaults(fn=cmd_status)

    sp = sub.add_parser("url", help="print the browser URL for a session",
                        description="Prints http://localhost:LPORT/lab?token=... .")
    sp.add_argument("--name")
    sp.set_defaults(fn=cmd_url)

    sp = sub.add_parser("logs", help="tail the job's stdout/stderr log",
                        description="Streams the cluster-side log file.")
    sp.add_argument("--name")
    sp.set_defaults(fn=cmd_logs)

    sp = sub.add_parser("adopt", help="discover sessions on the cluster, write local state",
                        description="Useful after losing local state, or when starting "
                                    "from a second laptop.")
    sp.add_argument("--name", help="adopt only this session")
    sp.set_defaults(fn=cmd_adopt)

    sp = sub.add_parser("tunnel", help="manage the local SSH tunnel for a session",
                        description="Re-open a session's SSH tunnel without resubmitting "
                                    "the Slurm job. Useful after laptop sleep or network drops.")
    tsub = sp.add_subparsers(dest="tunnel_cmd", required=True, metavar="<action>")

    tsp = tsub.add_parser("up", help="(re)open the SSH tunnel for a session",
                          description="Verifies the Slurm job is still active, then "
                                      "(re)establishes the local port forward.")
    tsp.add_argument("--name", help="session name (default: 'default' or sole session)")
    tsp.add_argument("--port", type=int, help="override LOCAL_PORT (also updates saved state)")
    tsp.set_defaults(fn=cmd_tunnel_up)

    sp = sub.add_parser("forward", help="open / close extra port forwards on a session's node",
                        description="Forward additional ports through the existing ControlMaster, "
                                    "targeting the compute node where a session's job runs. "
                                    "Forwards are tracked in session state and torn down on `down`.")
    fsub = sp.add_subparsers(dest="forward_cmd", required=True, metavar="<action>")

    fsp = fsub.add_parser("up", help="open port forwards to the session's node",
                          description="localhost:LOCAL -> NODE:REMOTE for each spec "
                                      "(default REMOTE=LOCAL). Several specs may be given.")
    fsp.add_argument("ports", nargs="+", metavar="PORT[:REMOTE]",
                     help="local port, or LOCAL:REMOTE pair; several may be given")
    fsp.add_argument("--remote", type=int,
                     help="remote port on the node (single PORT only; default: same as local)")
    fsp.add_argument("--node", help="override target node (default: session's NODE)")
    fsp.add_argument("--name", help="session name (default: sole tracked session)")
    fsp.set_defaults(fn=cmd_forward_up)

    fsp = fsub.add_parser("down", help="close tracked forwards",
                          description="Cancels the forward(s) and drops them from session state.")
    fsp.add_argument("ports", type=int, nargs="+", metavar="PORT",
                     help="local port(s) of the forward(s) to close")
    fsp.add_argument("--name", help="session name (default: sole tracked session)")
    fsp.set_defaults(fn=cmd_forward_down)

    fsp = fsub.add_parser("list", help="list extra forwards on tracked sessions",
                          description="Tracked extra forwards (excluding the jupyter tunnel).")
    fsp.add_argument("--name", help="limit to one session")
    fsp.set_defaults(fn=cmd_forward_list)

    sp = sub.add_parser("config", help="show resolved config",
                        description="Prints the resolved values; --init writes a starter TOML.")
    sp.add_argument("--init", action="store_true", help="write a starter config.toml")
    sp.set_defaults(fn=cmd_config)

    sp = sub.add_parser("inspect", help="cluster-state queries (gpus / nodes / wait)",
                        description="Read-only queries against Slurm.")
    isub = sp.add_subparsers(dest="inspect_cmd", required=True, metavar="<query>")

    isp = isub.add_parser("gpus", help="GPU usage by type",
                          description="Aggregates `scontrol show node` by GPU type.")
    isp.set_defaults(fn=cmd_inspect_gpus)

    isp = isub.add_parser("nodes", help="per-node usage grouped by partition",
                          description="Each node listed under every partition it belongs to.")
    isp.add_argument("--partition", help="narrow to one partition")
    isp.set_defaults(fn=cmd_inspect_nodes)

    isp = isub.add_parser("wait", help="start-time estimate for pending tracked sessions",
                          description="Default: pending tracked sessions only. "
                                      "Use --job to query an arbitrary job ID.")
    isp.add_argument("--job", help="query a specific JOB_ID instead of tracked sessions")
    isp.set_defaults(fn=cmd_inspect_wait)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    cfg = Config.load()
    try:
        args.fn(args, cfg)
    except SSHError as e:
        die(f"ssh: {e}")
    except SystemExit:
        raise
    except Exception as e:  # noqa: BLE001
        die(f"error: {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
