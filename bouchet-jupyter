class Config:
    def __init__(self, data: dict):
        self.data = data
        for k, v in DEFAULTS.items():
            setattr(self, k, data.get(k, v))
        self.local_port = int(self.local_port)
        # Merge user profiles on top of built-ins, key-by-key.
        self.profiles: dict[str, dict] = {k: dict(v) for k, v in BUILTIN_PROFILES.items()}
        for name, p in (data.get("profiles") or {}).items():
            base = self.profiles.get(name, {})
            base.update(p)
            self.profiles[name] = base
        self.overrides: dict = data.get("overrides") or {}

    @classmethod
    def load(cls) -> "Config":
        if CONFIG_LEGACY.exists() and not CONFIG_TOML.exists():
            migrate_bash_config()
        data: dict = {}
        if CONFIG_TOML.exists():
            data = toml_load(CONFIG_TOML)
        return cls(data)

    def resolve_profile(self, name: str) -> dict:
        if name not in self.profiles:
            avail = ", ".join(sorted(self.profiles))
            die(f"unknown profile: {name}\navailable: {avail}")
        merged = dict(self.profiles[name])
        for k in ("partition", "gpus", "cpus", "mem", "time"):
            v = self.overrides.get(k)
            if v not in (None, ""):
                merged[k] = v
        return merged


def migrate_bash_config() -> None:
    """Parse the legacy bash-sourced config into TOML.

    Conservative line-by-line parser (we don't shell-source it — the values
    contain literal `$HOME` that must survive into the TOML untouched).
    Recognized keys: top-level DEFAULTS, ad-hoc PARTITION/GPUS/CPUS/MEM/TIME,
    and PROFILE_<name>_<KEY>. Anything else is ignored with a notice.
    """
    top_keys = {k.upper(): k for k in DEFAULTS}
    override_keys = {"PARTITION", "GPUS", "CPUS", "MEM", "TIME"}
    profile_re = re.compile(r"^PROFILE_([A-Za-z][A-Za-z0-9]*)_(PARTITION|GPUS|CPUS|MEM|TIME)$")
    kv_re      = re.compile(r"^\s*([A-Za-z][A-Za-z0-9_]*)\s*=\s*(.*?)\s*(?:#.*)?$")

    top: dict = {}
    overrides: dict = {}
    profiles: dict[str, dict] = {}
    skipped: list[str] = []

    for raw in CONFIG_LEGACY.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = kv_re.match(raw)
        if not m:
            continue
        k, v = m.group(1), m.group(2)
        # Strip matched outer quotes (single or double).
        if len(v) >= 2 and v[0] == v[-1] and v[0] in ("'", '"'):
            v = v[1:-1]
        if v == "":
            continue
        if k in top_keys:
            top[top_keys[k]] = int(v) if top_keys[k] == "local_port" else v
        elif k in override_keys:
            overrides[k.lower()] = v
        elif (pm := profile_re.match(k)):
            pname, pkey = pm.group(1), pm.group(2).lower()
            profiles.setdefault(pname, {})[pkey] = int(v) if pkey == "cpus" else v
        else:
            skipped.append(k)

    # Render TOML by hand (small, tomllib is read-only).
    out: list[str] = []
    out.append("# Migrated from ~/.config/bouchet-jupyter/config")
    out.append(f"# on {datetime.now().isoformat(timespec='seconds')}")
    out.append("")
    for k in DEFAULTS:
        if k in top:
            out.append(f"{k} = {toml_value(top[k])}")
    if overrides:
        out.append("")
        out.append("[overrides]")
        for k in ("partition", "gpus", "cpus", "mem", "time"):
            if k in overrides:
                out.append(f"{k} = {toml_value(overrides[k])}")
    for pname, pdata in profiles.items():
        out.append("")
        out.append(f"[profiles.{pname}]")
        for k in ("partition", "gpus", "cpus", "mem", "time"):
            if k in pdata:
                out.append(f"{k} = {toml_value(pdata[k])}")

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_TOML.write_text("\n".join(out) + "\n")
    backup = CONFIG_LEGACY.with_suffix(".bak")
    CONFIG_LEGACY.rename(backup)
    print(f"migrated: {CONFIG_LEGACY} -> {CONFIG_TOML} (old kept as {backup.name})", file=sys.stderr)
    if skipped:
        print(f"  ignored unrecognized keys: {', '.join(skipped)}", file=sys.stderr)


def toml_value(v) -> str:
    if isinstance(v, bool):  return "true" if v else "false"
    if isinstance(v, int):   return str(v)
    return '"' + str(v).replace('\\', '\\\\').replace('"', '\\"') + '"'


# ---------------------------------------------------------------------------
# SSH wrapper
# ---------------------------------------------------------------------------

class SSHError(RuntimeError):
    pass


class SSH:
    """Thin wrapper around `ssh HOST <command>`. Relies on ControlMaster in
    ~/.ssh/config for connection multiplexing."""

    def __init__(self, host: str):
        self.host = host

    def run(self, cmd: str, *, check: bool = True, timeout: int = SSH_TIMEOUT,
            input_data: str | None = None, retry: bool = True) -> str:
        argv = ["ssh", self.host, cmd]
        last_err = ""
        for attempt in range(2 if retry else 1):
            try:
                r = subprocess.run(argv, capture_output=True, text=True,
                                   input=input_data, timeout=timeout)
            except subprocess.TimeoutExpired:
                last_err = f"ssh timeout after {timeout}s"
                continue
            if r.returncode == 0:
                return r.stdout.rstrip("\n")
            last_err = (r.stderr or r.stdout).strip()
            transient = ("Connection closed" in last_err or
                         "Connection reset" in last_err or
                         "kex_exchange" in last_err)
            if not transient or attempt > 0:
                break
        if check:
            raise SSHError(f"ssh `{cmd}` failed: {last_err}")
        return ""

    def forward(self, spec: str) -> None:
        # Touch the master first so -O has something to talk to.
        subprocess.run(["ssh", self.host, "true"], check=True, timeout=SSH_TIMEOUT)
        r = subprocess.run(["ssh", "-O", "forward", "-L", spec, self.host],
                           capture_output=True, text=True, timeout=SSH_TIMEOUT)
        if r.returncode != 0:
            raise SSHError(f"tunnel forward failed: {(r.stderr or r.stdout).strip()}")

    def cancel_forward(self, spec: str) -> None:
        subprocess.run(["ssh", "-O", "cancel", "-L", spec, self.host],
                       capture_output=True, text=True, timeout=SSH_TIMEOUT)


# ---------------------------------------------------------------------------
# Slurm queries
# ---------------------------------------------------------------------------

class Slurm:
    def __init__(self, ssh: SSH):
        self.ssh = ssh

    def nodes(self) -> list["Node"]:
        out = self.ssh.run("scontrol show node -o", timeout=30)
        return [Node.parse(line) for line in out.splitlines() if line.strip()]

    def my_pending(self) -> list[dict]:
        out = self.ssh.run("squeue --me -t PD -h -o '%i|%j|%P|%R|%Q'", timeout=15)
        rows = []
        for line in out.splitlines():
            parts = line.split("|")
            if len(parts) < 5:
                continue
            rows.append({"job_id": parts[0], "name": parts[1], "partition": parts[2],
                         "reason": parts[3].strip("()"), "priority": parts[4]})
        return rows

    def start_estimate(self, job_id: str) -> dict | None:
        out = self.ssh.run(f"squeue -j {shlex.quote(job_id)} --start -h -o '%S|%R|%Q|%P'",
                           timeout=15, check=False)
        if not out.strip():
            return None
        parts = out.strip().splitlines()[0].split("|")
        if len(parts) < 4:
            return None
        return {"start": parts[0], "reason": parts[1].strip("()"),
                "priority": parts[2], "partition": parts[3]}

    def submit(self, sbatch_dir: str, sbatch_file: str, sbatch_flags: list[str],
               session_name: str, state_remote_dir: str) -> str:
        """Submit and return JOB_ID, with double-capture for race resilience.

        Also clears any preexisting session.$name file before sbatch runs — if a
        previous job died without its cleanup trap firing (SIGKILL / node failure),
        the leftover file would otherwise be readable by polling before the new
        launcher's atomic write, and the laptop would tunnel to the wrong node.

        Paths (state_remote_dir / sbatch_dir) carry literal `$HOME` from config —
        keep them unquoted so the remote shell expands them. session_name is
        validated upstream (see validate_name)."""
        marker       = f"{state_remote_dir}/last-submit.{session_name}.id"
        session_file = f"{state_remote_dir}/session.{shlex.quote(session_name)}"
        flags  = " ".join(shlex.quote(f) for f in sbatch_flags)
        cmd = (f"mkdir -p {state_remote_dir} && rm -f {marker} {session_file} && "
               f"cd {sbatch_dir} && "
               f"sbatch --parsable --export=ALL,JC_SESSION={shlex.quote(session_name)} "
               f"{flags} {shlex.quote(sbatch_file)} | tee {marker}")
        out = self.ssh.run(cmd, timeout=30)
        job_id = (out.strip().splitlines() or [""])[-1].strip()
        if not job_id.isdigit():
            recovered = self.ssh.run(f"cat {marker} 2>/dev/null", check=False).strip()
            if recovered.isdigit():
                job_id = recovered
        if not job_id.isdigit():
            raise SSHError(f"could not parse JOB_ID (stdout={out!r})")
        return job_id

    def cancel(self, job_id: str) -> None:
        self.ssh.run(f"scancel {shlex.quote(job_id)}", check=False)

    def state(self, job_id: str) -> str:
        return self.ssh.run(f"squeue -h -j {shlex.quote(job_id)} -o '%T %R'", check=False).strip()

    def final_state(self, job_id: str) -> str:
        return self.ssh.run(f"sacct -j {shlex.quote(job_id)} -X -P -n -o State 2>/dev/null | head -1",
                            check=False).strip()


# ---------------------------------------------------------------------------
# Node parsing
# ---------------------------------------------------------------------------

GRES_GPU_RE = re.compile(r"gpu:([A-Za-z0-9_]+):(\d+)")
ALLOC_GPU_TYPED_RE = re.compile(r"gres/gpu:([A-Za-z0-9_]+)=(\d+)")
ALLOC_GPU_TOTAL_RE = re.compile(r"gres/gpu=(\d+)")


class Node:
    """Parsed `scontrol show node -o` line."""
    __slots__ = ("name", "state", "flags", "partitions", "cpu_alloc", "cpu_tot",
                 "real_mem_mb", "alloc_mem_mb", "gpu_type", "gpu_total", "gpu_alloc")

    def __init__(self, name, state, flags, partitions, cpu_alloc, cpu_tot,
                 real_mem_mb, alloc_mem_mb, gpu_type, gpu_total, gpu_alloc):
        self.name = name
        self.state = state
        self.flags = flags
        self.partitions = partitions
        self.cpu_alloc = cpu_alloc
        self.cpu_tot = cpu_tot
        self.real_mem_mb = real_mem_mb
        self.alloc_mem_mb = alloc_mem_mb
        self.gpu_type = gpu_type
        self.gpu_total = gpu_total
        self.gpu_alloc = gpu_alloc

    @classmethod
    def parse(cls, line: str) -> "Node":
        kv: dict[str, str] = {}
        for tok in line.split():
            if "=" in tok:
                k, _, v = tok.partition("=")
                kv[k] = v
        # Compound state like MIXED+PLANNED → base + flags.
        state_raw = kv.get("State", "")
        if "+" in state_raw:
            state, _, flags = state_raw.partition("+")
        else:
            state, flags = state_raw, ""
        partitions = [p for p in kv.get("Partitions", "").split(",") if p]

        gpu_type = ""
        gpu_total = 0
        gres = kv.get("Gres", "")
        if gres and gres != "(null)":
            for match in GRES_GPU_RE.finditer(gres):
                # First gpu: line wins; multi-type per node is rare on Bouchet.
                gpu_type = match.group(1)
                gpu_total = int(match.group(2))
                break

        gpu_alloc = 0
        alloc_tres = kv.get("AllocTRES", "")
        if alloc_tres:
            tm = ALLOC_GPU_TYPED_RE.search(alloc_tres)
            if tm and (not gpu_type or tm.group(1) == gpu_type):
                gpu_alloc = int(tm.group(2))
                if not gpu_type:
                    gpu_type = tm.group(1)
            else:
                tm2 = ALLOC_GPU_TOTAL_RE.search(alloc_tres)
                if tm2:
                    gpu_alloc = int(tm2.group(1))

        return cls(
            name=kv.get("NodeName", "?"),
            state=state,
            flags=flags,
            partitions=partitions,
            cpu_alloc=int(kv.get("CPUAlloc", "0") or 0),
            cpu_tot=int(kv.get("CPUTot", "0") or 0),
            real_mem_mb=int(kv.get("RealMemory", "0") or 0),
            alloc_mem_mb=int(kv.get("AllocMem", "0") or 0),
            gpu_type=gpu_type,
            gpu_total=gpu_total,
            gpu_alloc=gpu_alloc,
        )


def fmt_mb(mb: int) -> str:
    if mb >= 1024 * 1024:
        return f"{mb / 1024 / 1024:.1f}T"
    if mb >= 1024:
        return f"{mb / 1024:.0f}G"
    return f"{mb}M"


# ---------------------------------------------------------------------------
# Sessions (local state)
# ---------------------------------------------------------------------------

class Sessions:
    @staticmethod
    def session_path(name: str) -> Path:
        return STATE_DIR / f"session.{name}"

    @staticmethod
    def tunnel_path(name: str) -> Path:
        return STATE_DIR / f"tunnel.{name}.spec"

    @staticmethod
    def list_names() -> list[str]:
        if not STATE_DIR.exists():
            return []
        names: list[str] = []
        for p in sorted(STATE_DIR.iterdir()):
            if p.name.startswith("session.") and not p.name.endswith(".spec"):
                names.append(p.name[len("session."):])
        return names

    @staticmethod
    def load(name: str) -> dict:
        p = Sessions.session_path(name)
        return parse_kv(p.read_text()) if p.exists() else {}

    @staticmethod
    def save(name: str, data: dict) -> None:
        data = {**data, "SYNCED_AT": now_epoch_str()}
        body = "\n".join(f"{k}={v}" for k, v in data.items()) + "\n"
        atomic_write_text(Sessions.session_path(name), body)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def die(msg: str, code: int = 1) -> "NoReturn":  # type: ignore[name-defined]
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def now_epoch_str() -> str:
    return str(int(time.time()))


def atomic_write_text(path: Path, body: str, *, mode: int = 0o600) -> None:
    """Write `body` to `path` via tempfile + rename so readers never see a torn file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w") as f:
            f.write(body)
        os.replace(tmp, str(path))
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def validate_name(name: str) -> str:
    if not NAME_RE.match(name):
        die(f"invalid session name {name!r} (use only letters, digits, '.', '_', '-')")
    return name


def port_in_use(p: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind(("127.0.0.1", p))
            return False
        except OSError:
            return True


def pick_free_port(base: int, span: int = 50, *,
                   reserved: set[int] = frozenset()) -> int:
    for p in range(base, base + span):
        if p in reserved:
            continue
        if not port_in_use(p):
            return p
    die(f"no free local port in [{base},{base + span - 1}]")


def reserved_local_ports(exclude_name: str | None = None) -> set[int]:
    """LOCAL_PORTs already assigned to other tracked sessions.

    Cache-only — does not ssh. We treat any tracked session's port as taken
    even if its tunnel happens to be down right now, because that session
    will try to re-open on the same port (e.g. via `tunnel up` or `adopt`).
    """
    out: set[int] = set()
    for n in Sessions.list_names():
        if n == exclude_name:
            continue
        try:
            out.add(int(Sessions.load(n).get("LOCAL_PORT", "")))
        except (ValueError, TypeError):
            pass
    return out


def parse_forwards(s: str) -> list[tuple[int, int]]:
    out: list[tuple[int, int]] = []
    for tok in (s or "").split(","):
        tok = tok.strip()
        if not tok:
            continue
        l, _, r = tok.partition(":")
        try:
            out.append((int(l), int(r)))
        except ValueError:
            continue
    return out


def format_forwards(items: list[tuple[int, int]]) -> str:
    return ",".join(f"{l}:{r}" for l, r in items)


def parse_kv(blob: str) -> dict:
    out: dict = {}
    for line in (blob or "").splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            out[k.strip()] = v.strip()
    return out


def read_tunnel_spec(name: str) -> str | None:
    """Return the saved `LPORT:NODE:RPORT` for the session's primary tunnel, or None."""
    tspec = Sessions.tunnel_path(name)
    if not tspec.exists():
        return None
    return tspec.read_text().strip() or None


def parse_iso(s: str) -> datetime | None:
    try:
        return datetime.fromisoformat(s)
    except (ValueError, TypeError):
        return None


def fmt_eta(start: str) -> str:
    dt = parse_iso(start)
    if not dt:
        return "-"
    now = datetime.now(dt.tzinfo) if dt.tzinfo else datetime.now()
    delta = (dt - now).total_seconds()
    if delta < 0:
        return "now"
    h, rem = divmod(int(delta), 3600)
    m = rem // 60
    if h >= 24:
        return f"in {h // 24}d {h % 24}h"
    if h:
        return f"in {h}h {m}m"
    return f"in {m}m"


def forward_or_die(ssh: SSH, spec: str, port: int, port_busy_hint: str) -> None:
    """Open an SSH port forward, translating port-collision errors to a friendly die."""
    try:
        ssh.forward(spec)
    except SSHError as e:
        msg = str(e)
        if "in use" in msg or "Address already in use" in msg or "cannot listen" in msg.lower():
            die(f"local port {port} is in use by another process; {port_busy_hint}")
        die(f"forward failed: {msg}")


def close_session_forwards(name: str, ssh: SSH, payload: dict) -> None:
    """Cancel a session's primary tunnel and any tracked extra forwards. Best-effort."""
    spec = read_tunnel_spec(name)
    if spec:
        try:
            ssh.cancel_forward(spec)
        except Exception:
            pass
    Sessions.tunnel_path(name).unlink(missing_ok=True)
    node = payload.get("NODE")
    if node:
        for lport, rport in parse_forwards(payload.get("FORWARDS", "")):
            try:
                ssh.cancel_forward(f"{lport}:{node}:{rport}")
            except Exception:
                pass


def push_env_file(ssh: SSH, env_cmd: str, state_remote_dir: str) -> None:
    if env_cmd:
        body = (f"# generated by bouchet-jupyter — edit ~/.config/bouchet-jupyter/"
                f"config.toml on your laptop\n{env_cmd}\n")
        ssh.run(f"mkdir -p {state_remote_dir} && cat > {state_remote_dir}/env.sh",
                input_data=body)
    else:
        ssh.run(f"rm -f {state_remote_dir}/env.sh", check=False)


def build_sbatch_flags(profile: dict) -> list[str]:
    flags: list[str] = []
    for k, prefix in (("partition", "--partition="), ("gpus", "--gpus="),
                      ("cpus", "--cpus-per-task="), ("mem", "--mem="),
                      ("time", "--time=")):
        v = profile.get(k)
        if v not in (None, ""):
            flags.append(f"{prefix}{v}")
    return flags


def resolve_name_for_read(arg_name: str | None) -> str:
    if arg_name:
        return validate_name(arg_name)
    names = Sessions.list_names()
    if not names:
        die("no tracked sessions — run 'bouchet-jupyter up' first")
    if len(names) == 1:
        return names[0]
    die("multiple sessions tracked — pass --name <NAME>:\n  " + "\n  ".join(names))


# ---------------------------------------------------------------------------
# Session sync — cluster is the source of truth
# ---------------------------------------------------------------------------

# Slurm states that mean the job is truly done (sacct reports them).
TERMINAL_SACCT = {"COMPLETED", "FAILED", "CANCELLED", "TIMEOUT",
                   "OUT_OF_MEMORY", "PREEMPTED", "NODE_FAIL",
                   "BOOT_FAIL", "DEADLINE"}
# Squeue states that mean the job is shutting down — jupyter is going away.
WIND_DOWN_STATES = {"COMPLETING", "CG"}
# Window after submit during which squeue may not yet show the job.
SUBMIT_GRACE_S = 30
# How long a saved sync stays trusted without re-checking the cluster.
DEFAULT_FRESH_S = 5

SessionStatus = Literal["live", "launching", "winding_down",
                        "stale", "stale_unverified", "missing", "unknown"]


@dataclass
class SessionView:
    name: str
    status: SessionStatus
    payload: dict           # local merged with remote (NODE/PORT/TOKEN/JOB_ID/...)
    job_state: str | None   # raw squeue %T (e.g. "RUNNING") or None
    age_s: int              # seconds since SYNCED_AT (0 after a fresh pull)
    notes: list[str] = field(default_factory=list)
    extras: dict = field(default_factory=dict)  # display-only: elapsed/limit/reason


def local_age_s(payload: dict) -> int:
    try:
        return max(0, int(time.time()) - int(payload.get("SYNCED_AT", "0")))
    except ValueError:
        return sys.maxsize


def submitted_age_s(payload: dict) -> int | None:
    raw = payload.get("SUBMITTED_AT")
    if not raw:
        return None
    try:
        return max(0, int(time.time()) - int(raw))
    except ValueError:
        return None


def is_terminal(sacct_out: str) -> bool:
    head = (sacct_out.split() or [""])[0].rstrip("+") if sacct_out else ""
    return head in TERMINAL_SACCT


def autoclean_session(name: str, payload: dict, ssh: SSH, notes: list[str]) -> None:
    close_session_forwards(name, ssh, payload)
    Sessions.session_path(name).unlink(missing_ok=True)
    jid = payload.get("JOB_ID", "?")
    notes.append(f"[{name}] cleaned stale (job {jid} ended)")


def print_notes(view: SessionView) -> None:
    for n in view.notes:
        print(n, file=sys.stderr)


def print_all_notes(views: dict[str, SessionView]) -> None:
    for v in views.values():
        print_notes(v)


def view_from_cache(name: str) -> SessionView:
    """Synthesize a SessionView from local state alone (no cluster check)."""
    local = Sessions.load(name)
    return SessionView(
        name=name,
        status="live" if local.get("TOKEN") else "launching",
        payload=local, job_state=None,
        age_s=local_age_s(local),
    )


def require_live(view: SessionView, *, fallback: str | None = None) -> None:
    """Print autoclean notes; die if the session isn't ready to use."""
    print_notes(view)
    if view.status != "live":
        die(status_message(view) or fallback or f"session '{view.name}' is not ready")


def classify_status(local: dict, remote_present: bool, remote_has_token: bool,
              remote_job_match: bool,
              squeue_state: str | None, squeue_ok: bool,
              sacct_state: str | None) -> SessionStatus:
    if not squeue_ok:
        return "unknown"
    if squeue_state in WIND_DOWN_STATES:
        return "winding_down"
    if squeue_state:
        # "live" requires the cluster file to describe THIS job. Otherwise the
        # new job's launcher hasn't yet rewritten it — keep waiting.
        return "live" if (remote_has_token and remote_job_match) else "launching"
    # squeue reports no such job (or no JOB_ID was tracked yet).
    if not local and not remote_present:
        return "missing"
    submitted_age = submitted_age_s(local)
    if submitted_age is not None and submitted_age < SUBMIT_GRACE_S and not remote_has_token:
        return "launching"
    if sacct_state and is_terminal(sacct_state):
        return "stale"
    return "stale_unverified"


def remote_job_matches(local: dict, remote: dict) -> bool:
    """True iff the remote session payload describes the same job we're tracking.

    When `local` has not yet pinned a JOB_ID (e.g. `adopt` discovering a session
    that only exists on the cluster), we trust whatever remote says. Once we've
    submitted a job, we require remote.JOB_ID to match before treating its
    NODE/PORT/TOKEN as ours — otherwise the file is a leftover from a previous
    job whose cleanup didn't fire (SIGKILL / node failure / bypassed trap)."""
    l = local.get("JOB_ID", "").strip()
    if not l:
        return True
    r = remote.get("JOB_ID", "").strip()
    return bool(r) and l == r


def merge_remote(local: dict, remote: dict) -> dict:
    """Cluster owns NODE/PORT/TOKEN/JOB_ID for the current job; local owns the rest.

    Refuses to merge when remote describes a different JOB_ID — that file is from
    a previous job and merging it would poison local state with the wrong
    NODE/PORT/TOKEN, causing a tunnel to the wrong host."""
    if not remote_job_matches(local, remote):
        return dict(local)
    payload = dict(local)
    for k in ("NODE", "PORT", "TOKEN", "JOB_ID"):
        if remote.get(k):
            payload[k] = remote[k]
    return payload


def ssh_one_session(ssh: SSH, slurm: Slurm, cfg: Config, name: str
                     ) -> tuple[bool, dict, str | None, dict, str | None]:
    """Return (squeue_ok, remote, squeue_state, squeue_extras, sacct_state)."""
    payload_local = Sessions.load(name)
    job_id = payload_local.get("JOB_ID", "")
    rfile = f"{cfg.state_remote_dir}/session.{shlex.quote(name)}"
    parts = ["echo ==CAT==", f"cat {rfile} 2>/dev/null", "echo ==SQ=="]
    if job_id:
        parts.append(f"squeue -h -j {shlex.quote(job_id)} -o '%T|%R|%M|%l' 2>/dev/null")
    try:
        out = ssh.run(" ; ".join(parts), check=False, retry=True)
    except SSHError:
        return False, {}, None, {}, None
    cat_block, _, sq_block = out.partition("==SQ==")
    cat_block = cat_block.replace("==CAT==", "").strip("\n")
    remote = parse_kv(cat_block)
    sq_state: str | None = None
    extras: dict = {}
    if job_id and sq_block.strip():
        f = sq_block.strip().split("|")
        if len(f) >= 1:
            sq_state = f[0]
        if len(f) >= 2:
            extras["reason"] = f[1].strip("()")
        if len(f) >= 3:
            extras["elapsed"] = f[2]
        if len(f) >= 4:
            extras["limit"] = f[3]
    sacct_state: str | None = None
    if job_id and not sq_state:
        try:
            sacct_state = slurm.final_state(job_id)
        except SSHError:
            sacct_state = None
    return True, remote, sq_state, extras, sacct_state


def sync_one(name: str, ssh: SSH, slurm: Slurm, cfg: Config,
             *, max_age_s: int = DEFAULT_FRESH_S,
             autoclean: bool = True) -> SessionView:
    local = Sessions.load(name)
    age = local_age_s(local)
    if local and "JOB_ID" in local and age < max_age_s:
        return SessionView(
            name=name,
            status="live" if local.get("TOKEN") else "launching",
            payload=local, job_state=None, age_s=age,
        )
    squeue_ok, remote, sq_state, extras, sacct_state = ssh_one_session(ssh, slurm, cfg, name)
    status = classify_status(local, bool(remote), bool(remote.get("TOKEN")),
                       remote_job_matches(local, remote),
                       sq_state, squeue_ok, sacct_state)
    payload = merge_remote(local, remote)
    notes: list[str] = []
    if status == "stale" and autoclean and (local or remote):
        autoclean_session(name, payload, ssh, notes)
        payload = {}
    elif status in ("live", "launching") and (local or remote):
        Sessions.save(name, payload)
        payload = Sessions.load(name)
    return SessionView(name=name, status=status, payload=payload,
                       job_state=sq_state,
                       age_s=0 if squeue_ok else age,
                       notes=notes, extras=extras)


def sync_all(ssh: SSH, slurm: Slurm, cfg: Config,
             *, autoclean: bool = True) -> dict[str, SessionView]:
    rdir = cfg.state_remote_dir
    cmd = (
        'echo ==FILES== ; '
        f'for f in {rdir}/session.* ; do '
        '  [ -e "$f" ] || continue ; '
        '  echo "==FILE==$(basename $f)" ; '
        '  cat "$f" ; '
        'done ; '
        'echo ==SQUEUE== ; '
        'squeue --me --name=jupyter -h -o "%i|%T|%R|%M|%l|%N" 2>/dev/null'
    )
    try:
        out = ssh.run(cmd, check=False, retry=True)
        squeue_ok = True
    except SSHError:
        out, squeue_ok = "", False

    files_block, _, squeue_block = out.partition("==SQUEUE==")
    remote_by_name: dict[str, dict] = {}
    cur_name: str | None = None
    cur_lines: list[str] = []
    for line in files_block.splitlines():
        if line.startswith("==FILES=="):
            continue
        if line.startswith("==FILE=="):
            if cur_name is not None:
                remote_by_name[cur_name] = parse_kv("\n".join(cur_lines))
            tag = line[len("==FILE=="):].strip()
            cur_name = tag[len("session."):] if tag.startswith("session.") else tag
            cur_lines = []
        elif cur_name is not None:
            cur_lines.append(line)
    if cur_name is not None:
        remote_by_name[cur_name] = parse_kv("\n".join(cur_lines))

    live_jobs: dict[str, str] = {}
    live_extras: dict[str, dict] = {}
    for line in (squeue_block or "").splitlines():
        parts = line.split("|")
        if len(parts) >= 2 and parts[0].strip().isdigit():
            jid = parts[0].strip()
            live_jobs[jid] = parts[1].strip()
            extra: dict = {}
            if len(parts) >= 3:
                extra["reason"] = parts[2].strip("()")
            if len(parts) >= 4:
                extra["elapsed"] = parts[3].strip()
            if len(parts) >= 5:
                extra["limit"] = parts[4].strip()
            if len(parts) >= 6:
                extra["node"] = parts[5].strip()
            live_extras[jid] = extra

    names = set(Sessions.list_names()) | set(remote_by_name.keys())
    views: dict[str, SessionView] = {}
    for n in sorted(names):
        local = Sessions.load(n)
        remote = remote_by_name.get(n, {})
        # Local JOB_ID is authoritative — it's what we submitted. Fall back to
        # remote only when local hasn't pinned one yet (adopt of a cluster-only
        # session). Reading remote first would let a stale leftover file pick
        # the wrong job for squeue / sacct lookup.
        job_id = (local.get("JOB_ID") or remote.get("JOB_ID") or "").strip()
        sq_state = live_jobs.get(job_id) if job_id else None
        sacct_state: str | None = None
        if squeue_ok and job_id and not sq_state:
            try:
                sacct_state = slurm.final_state(job_id)
            except SSHError:
                sacct_state = None
        status = classify_status(local, bool(remote), bool(remote.get("TOKEN")),
                           remote_job_matches(local, remote),
                           sq_state, squeue_ok, sacct_state)
        payload = merge_remote(local, remote)
        notes: list[str] = []
        if status == "stale" and autoclean and (local or remote):
            autoclean_session(n, payload, ssh, notes)
            payload = {}
        elif status in ("live", "launching") and (local or remote):
            Sessions.save(n, payload)
            payload = Sessions.load(n)
        views[n] = SessionView(name=n, status=status, payload=payload,
                               job_state=sq_state,
                               age_s=0 if squeue_ok else local_age_s(local),
                               notes=notes,
                               extras=live_extras.get(job_id, {}) if job_id else {})
    return views


def status_message(view: SessionView) -> str:
    """Single-line explanation of why a non-live status is non-live."""
    n = view.name
    jid = view.payload.get("JOB_ID", "?")
    if view.status == "live":
        return ""
    if view.status == "launching":
        return (f"session '{n}' is still launching (jupyter not yet up); "
                f"check 'bouchet-jupyter status --name {n}'")
    if view.status == "winding_down":
        return (f"session '{n}' is winding down (job {jid} {view.job_state}); "
                f"wait for it to finish, then 'bouchet-jupyter up --name {n}'")
    if view.status == "stale":
        return (f"session '{n}' is no longer running and has been cleaned up; "
                f"'bouchet-jupyter up --name {n}' to start a new one")
    if view.status == "stale_unverified":
        return (f"session '{n}': job {jid} is not in squeue but sacct didn't "
                f"confirm a terminal state — 'bouchet-jupyter down --name {n}' "
                f"to clean up if it's truly gone")
    if view.status == "missing":
        return f"no session named '{n}' (run 'bouchet-jupyter up --name {n}' to create one)"
    return f"could not reach the cluster to verify '{n}'; using cached state"


