#!/usr/bin/env python3
"""bouchet-jupyter — launch / tear down JupyterLab sessions on Bouchet.

Run `bouchet-jupyter --help` for usage. Config lives at
~/.config/bouchet-jupyter/config.toml; on first run an existing bash-style
config in the same directory is migrated automatically.
"""
from __future__ import annotations

import argparse
import os
import re
import shlex
import socket
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

try:
    import tomllib  # Python 3.11+ stdlib
except ImportError:
    try:
        import tomli as tomllib  # type: ignore[no-redef]  # pip install --user tomli
    except ImportError:
        sys.stderr.write(
            "bouchet-jupyter needs a TOML reader. On Python 3.11+ this is stdlib;\n"
            "on older Pythons run: pip install --user tomli\n"
        )
        sys.exit(1)


def _toml_load(path: Path) -> dict:
    with open(path, "rb") as f:
        return tomllib.load(f)

