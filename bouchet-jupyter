def cmd_up(args, cfg: Config) -> None:
    name    = validate_name(args.name or "default")
    profile = args.profile or cfg.default_profile

    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)

    pre = sync_one(name, ssh, slurm, cfg, max_age_s=0)
    print_notes(pre)
    if pre.status == "live":
        die(f"session '{name}' is already running (job {pre.payload.get('JOB_ID','?')}); "
            f"use 'bouchet-jupyter url --name {name}' or 'tunnel up --name {name}'")
    if pre.status == "launching":
        die(f"session '{name}' is already launching (job {pre.payload.get('JOB_ID','?')}); "
            f"wait, or 'bouchet-jupyter down --name {name}' first")
    if pre.status == "winding_down":
        die(f"session '{name}' is winding down (job {pre.payload.get('JOB_ID','?')}); "
            f"wait for it to clear, then re-run 'up'")
    if pre.status == "stale_unverified":
        die(f"session '{name}': job {pre.payload.get('JOB_ID','?')} is not in squeue but "
            f"sacct didn't confirm — 'bouchet-jupyter down --name {name}' first")
    if pre.status == "unknown":
        die("could not reach the cluster — check ssh connectivity")
    # 'stale' has been auto-cleaned; 'missing' is the green path. Both proceed.

    resolved  = cfg.resolve_profile(profile)
    base_port = args.port or cfg.local_port
    lport     = pick_free_port(base_port, reserved=reserved_local_ports(exclude_name=name))

    print("Syncing env to cluster...")
    push_env_file(ssh, cfg.env_cmd, cfg.state_remote_dir)

    flags = build_sbatch_flags(resolved)
    print(f"Submitting job (profile={profile}, name={name})...")
    job_id = slurm.submit(cfg.sbatch_dir, cfg.sbatch_file, flags, name, cfg.state_remote_dir)
    Sessions.save(name, {"JOB_ID": job_id, "PROFILE": profile,
                         "LOCAL_PORT": str(lport),
                         "SUBMITTED_AT": now_epoch_str()})
    print(f"  job {job_id}  flags: {' '.join(flags) or '<sbatch defaults>'}  local_port={lport}")

    print("Waiting for jupyter to start (Ctrl-C to stop waiting)...")
    delay = POLL_START
    last_state = ""
    try:
        while True:
            view = sync_one(name, ssh, slurm, cfg, max_age_s=0, autoclean=False)
            if view.status == "live":
                break
            if view.status in ("stale", "winding_down"):
                notes: list[str] = []
                autoclean_session(name, view.payload, ssh, notes)
                for note in notes:
                    print(note, file=sys.stderr)
                die(f"  job {job_id} left the queue ({view.status}) — aborting")
            if view.status == "unknown":
                pass  # transient ssh failure; keep polling
            elif view.job_state and view.job_state != last_state:
                print(f"  {view.job_state}")
                last_state = view.job_state
            time.sleep(delay)
            delay = min(int(delay * 2), POLL_MAX)
    except KeyboardInterrupt:
        print()
        print(f"interrupted — job {job_id} still queued. "
              f"Run \"bouchet-jupyter down --name {name}\" to scancel.")
        raise SystemExit(130)

    s = Sessions.load(name)
    print(f"  node={s['NODE']} port={s['PORT']}")
    spec = f"{lport}:{s['NODE']}:{s['PORT']}"
    print(f"Opening tunnel localhost:{lport} -> {s['NODE']}:{s['PORT']} via {cfg.host}...")
    ssh.forward(spec)
    atomic_write_text(Sessions.tunnel_path(name), spec + "\n")

    url = f"http://localhost:{lport}/lab?token={s['TOKEN']}"
    print()
    print(f"  {url}")
    print()
    for opener in ("open", "xdg-open"):
        if subprocess.run(["which", opener], capture_output=True).returncode == 0:
            subprocess.run([opener, url], capture_output=True)
            break


def down_one(name: str, ssh: SSH, cfg: Config) -> None:
    s = Sessions.load(name)
    close_session_forwards(name, ssh, s)
    Sessions.session_path(name).unlink(missing_ok=True)
    if s.get("JOB_ID"):
        Slurm(ssh).cancel(s["JOB_ID"])
        print(f"[{name}] scancelled {s['JOB_ID']}")
    ssh.run(f"rm -f {cfg.state_remote_dir}/session.{shlex.quote(name)}", check=False)
    print(f"[{name}] tunnel down")


def cmd_down(args, cfg: Config) -> None:
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    if args.all:
        views = sync_all(ssh, slurm, cfg)
        for v in views.values():
            for line in v.notes:
                print(line, file=sys.stderr)
        names = Sessions.list_names()
        if not names:
            print("(no tracked sessions)")
            return
        for n in names:
            down_one(n, ssh, cfg)
        return
    name = validate_name(args.name or "default")
    view = sync_one(name, ssh, slurm, cfg, max_age_s=0)
    print_notes(view)
    if view.status == "missing":
        die(f"no session named '{name}'")
    if view.status == "stale":
        # autoclean ran inside sync_one
        return
    if view.status == "unknown":
        die("could not reach the cluster — check ssh connectivity")
    down_one(name, ssh, cfg)


def print_list_rows(views: dict[str, SessionView]) -> None:
    rows = [v for v in views.values() if v.payload]
    if not rows:
        print("(no tracked sessions)")
        return
    lport_owners: dict[str, list[str]] = {}
    for v in rows:
        lp = v.payload.get("LOCAL_PORT")
        if lp:
            lport_owners.setdefault(lp, []).append(v.name)
    for lp, names in lport_owners.items():
        if len(names) > 1:
            print(f"warning: LOCAL_PORT {lp} is shared by {', '.join(names)} — "
                  f"only one tunnel can bind it; run 'tunnel up --name <other> --port <free>'",
                  file=sys.stderr)
    print(f"{'NAME':<12} {'PROFILE':<7} {'JOB_ID':<10} {'STATE':<14} {'NODE':<14} "
          f"{'LPORT':<6} {'RPORT':<6} ELAPSED/LIMIT")
    for v in sorted(rows, key=lambda x: x.name):
        s = v.payload
        jid = s.get("JOB_ID", "?")
        node = s.get("NODE") or v.extras.get("node", "-")
        elapsed = v.extras.get("elapsed", "-")
        limit   = v.extras.get("limit", "-")
        # Display a single STATE token combining squeue state + our status.
        if v.status == "live":
            state = v.job_state or "RUNNING"
        elif v.status == "launching":
            state = v.job_state or "LAUNCHING"
        elif v.status == "winding_down":
            state = v.job_state or "COMPLETING"
        else:
            state = v.status.upper()
        print(f"{v.name:<12} {s.get('PROFILE','?'):<7} {jid:<10} {state:<14} "
              f"{node:<14} {s.get('LOCAL_PORT','?'):<6} {s.get('PORT','-'):<6} "
              f"{elapsed}/{limit}")


def cmd_list(args, cfg: Config) -> None:
    if getattr(args, "no_sync", False):
        views = {n: view_from_cache(n) for n in sorted(Sessions.list_names())}
        print_list_rows(views)
        return
    ssh = SSH(cfg.host)
    views = sync_all(ssh, Slurm(ssh), cfg)
    print_all_notes(views)
    print_list_rows(views)


def cmd_status(args, cfg: Config) -> None:
    if not args.name:
        cmd_list(args, cfg)
        return
    name = validate_name(args.name)
    if getattr(args, "no_sync", False):
        view = view_from_cache(name)
        if not view.payload:
            die(f"no session named '{name}'")
    else:
        ssh = SSH(cfg.host)
        view = sync_one(name, ssh, Slurm(ssh), cfg, max_age_s=DEFAULT_FRESH_S)
        print_notes(view)
    if view.status == "missing":
        die(f"no session named '{name}'")
    s = view.payload
    for k in ("JOB_ID", "PROFILE", "LOCAL_PORT", "NODE", "PORT", "TOKEN",
              "FORWARDS", "SUBMITTED_AT", "SYNCED_AT"):
        if k in s:
            print(f"{k}={s[k]}")
    print()
    if view.status == "live":
        print(f"job {s['JOB_ID']}: {view.job_state or 'RUNNING'}  (jupyter ready)")
    elif view.status == "launching":
        print(f"job {s.get('JOB_ID','?')}: {view.job_state or 'pending'}  (jupyter not yet up)")
    else:
        msg = status_message(view)
        if msg:
            print(msg)


def cmd_url(args, cfg: Config) -> None:
    name = resolve_name_for_read(args.name)
    ssh  = SSH(cfg.host)
    view = sync_one(name, ssh, Slurm(ssh), cfg, max_age_s=DEFAULT_FRESH_S)
    require_live(view)
    if not view.payload.get("TOKEN"):
        die(status_message(view) or f"session '{name}' has no TOKEN yet")
    s = view.payload
    lport = s.get("LOCAL_PORT")
    if not lport:
        die(f"session '{name}' has no LOCAL_PORT recorded; "
            f"run 'bouchet-jupyter tunnel up --name {name}' first")
    spec = read_tunnel_spec(name)
    if not spec or spec.split(":", 1)[0] != lport:
        die(f"session '{name}': no live tunnel on port {lport} "
            f"(tunnel.spec {'missing' if not spec else 'has '+spec}); "
            f"run 'bouchet-jupyter tunnel up --name {name}'")
    print(f"http://localhost:{lport}/lab?token={s['TOKEN']}")


def cmd_logs(args, cfg: Config) -> None:
    name  = resolve_name_for_read(args.name)
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    view  = sync_one(name, ssh, slurm, cfg, max_age_s=30)
    print_notes(view)
    jid = view.payload.get("JOB_ID")
    if not jid:
        die(status_message(view) or f"session '{name}' has no JOB_ID")
    # Stream — replace this process so Ctrl-C propagates cleanly.
    os.execvp("ssh", ["ssh", cfg.host, f"tail -f {cfg.log_dir}/jupyter-{jid}.out"])


def cmd_config(args, cfg: Config) -> None:
    if args.init:
        if CONFIG_TOML.exists():
            die(f"{CONFIG_TOML} already exists")
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_TOML.write_text(starter_toml())
        print(f"wrote {CONFIG_TOML}")
        return
    print(f"config file: {CONFIG_TOML}  (exists: {'yes' if CONFIG_TOML.exists() else 'no'})")
    print()
    for k in DEFAULTS:
        v = getattr(cfg, k)
        print(f"  {k:<18} = {v}")
    print()
    print("ad-hoc overrides:")
    for k in ("partition", "gpus", "cpus", "mem", "time"):
        print(f"  {k:<10} = {cfg.overrides.get(k, '<from profile>')}")
    print()
    print("profiles:")
    for pname in sorted(cfg.profiles):
        p = cfg.profiles[pname]
        print(f"  {pname:<6} partition={p.get('partition',''):<10} "
              f"gpus={p.get('gpus','') or '-':<8} "
              f"cpus={p.get('cpus',''):<3} mem={p.get('mem',''):<5} "
              f"time={p.get('time','')}")


def starter_toml() -> str:
    return f"""# bouchet-jupyter config

host = "{DEFAULTS['host']}"
local_port = {DEFAULTS['local_port']}
sbatch_dir = "{DEFAULTS['sbatch_dir']}"
sbatch_file = "{DEFAULTS['sbatch_file']}"
log_dir = "{DEFAULTS['log_dir']}"
state_remote_dir = "{DEFAULTS['state_remote_dir']}"
default_profile = "{DEFAULTS['default_profile']}"
env_cmd = "module load JupyterLab/4.2.5-GCCcore-13.3.0"

# Built-in profiles (gpu, cpu) are baked in. Override per-key with
# [profiles.<name>] tables; add new profiles the same way.
# [profiles.gpu]
# time = "04:00:00"
#
# [profiles.b200]
# partition = "gpu_b200"
# gpus = "b200:1"
# cpus = 8
# mem = "64G"
# time = "08:00:00"

# [overrides]
# partition = "..."
# gpus = "..."
"""


def cmd_adopt(args, cfg: Config) -> None:
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    views = sync_all(ssh, slurm, cfg)
    for v in views.values():
        for line in v.notes:
            print(line, file=sys.stderr)
    targets = [v for v in views.values() if v.status in ("live", "launching")]
    if args.name:
        targets = [v for v in targets if v.name == args.name]
    if not targets:
        print("(nothing to adopt)")
        return
    adopted = 0
    used_ports = reserved_local_ports()
    for v in targets:
        s = v.payload
        if not s.get("LOCAL_PORT"):
            lport = pick_free_port(cfg.local_port, reserved=used_ports)
            s["LOCAL_PORT"] = str(lport)
            used_ports.add(lport)
            Sessions.save(v.name, s)
            s = Sessions.load(v.name)
        else:
            try:
                used_ports.add(int(s["LOCAL_PORT"]))
            except (ValueError, TypeError):
                pass
        if not s.get("TOKEN") or not s.get("NODE") or not s.get("PORT"):
            print(f"[{v.name}] skipped (job still launching, no TOKEN yet)")
            continue
        adopted += 1
        spec = f"{s['LOCAL_PORT']}:{s['NODE']}:{s['PORT']}"
        if read_tunnel_spec(v.name) == spec:
            print(f"[{v.name}] adopted (tunnel already up)")
            continue
        try:
            ssh.forward(spec)
            atomic_write_text(Sessions.tunnel_path(v.name), spec + "\n")
            print(f"[{v.name}] adopted, tunnel localhost:{s['LOCAL_PORT']} -> "
                  f"{s['NODE']}:{s['PORT']}")
        except SSHError as e:
            print(f"[{v.name}] adopted, but tunnel failed: {e}", file=sys.stderr)
    if adopted == 0:
        print("(nothing adopted)")


# ---------------------------------------------------------------------------
# Tunnel subcommands
# ---------------------------------------------------------------------------

def cmd_tunnel_up(args, cfg: Config) -> None:
    name  = resolve_name_for_read(args.name)
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    view  = sync_one(name, ssh, slurm, cfg, max_age_s=0)
    require_live(view)
    s = view.payload
    if not s.get("LOCAL_PORT"):
        s["LOCAL_PORT"] = str(pick_free_port(
            cfg.local_port, reserved=reserved_local_ports(exclude_name=name)))
        Sessions.save(name, s)
        s = Sessions.load(name)

    if args.port is not None:
        lport = args.port
        if lport in reserved_local_ports(exclude_name=name):
            die(f"port {lport} is already assigned to another tracked session; "
                f"pass a different --port or 'down' the other one first")
    else:
        lport = int(s["LOCAL_PORT"])

    spec = f"{lport}:{s['NODE']}:{s['PORT']}"
    old_spec = read_tunnel_spec(name)
    if old_spec:
        # Always cancel the previous forward (cancel_forward is idempotent), so
        # `tunnel up` can re-open a tunnel that ssh's mux still thinks exists.
        ssh.cancel_forward(old_spec)

    forward_or_die(ssh, spec, lport, "pass --port NEW to pick a different one")
    atomic_write_text(Sessions.tunnel_path(name), spec + "\n")
    if str(lport) != s.get("LOCAL_PORT"):
        s["LOCAL_PORT"] = str(lport)
        Sessions.save(name, s)
    print(f"Tunnel up: localhost:{lport} -> {s['NODE']}:{s['PORT']}")
    print(f"http://localhost:{lport}/lab?token={s['TOKEN']}")


# ---------------------------------------------------------------------------
# Forward subcommands (extra port forwards on a session's node)
# ---------------------------------------------------------------------------

def cmd_forward_up(args, cfg: Config) -> None:
    name  = resolve_name_for_read(args.name)
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    view  = sync_one(name, ssh, slurm, cfg, max_age_s=DEFAULT_FRESH_S)
    require_live(view)
    s = view.payload
    node = args.node or s.get("NODE")
    if not node:
        die(f"session '{name}' has no NODE — pass --node, or wait for the job to start")
    rport = args.remote if args.remote is not None else args.port
    spec  = f"{args.port}:{node}:{rport}"
    forward_or_die(ssh, spec, args.port, "pass a different port")
    s = Sessions.load(name)
    forwards = [(l, r) for l, r in parse_forwards(s.get("FORWARDS", "")) if l != args.port]
    forwards.append((args.port, rport))
    s["FORWARDS"] = format_forwards(forwards)
    Sessions.save(name, s)
    print(f"Forward up: localhost:{args.port} -> {node}:{rport}  (session={name})")


def cmd_forward_down(args, cfg: Config) -> None:
    name  = resolve_name_for_read(args.name)
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    view  = sync_one(name, ssh, slurm, cfg, max_age_s=DEFAULT_FRESH_S)
    print_notes(view)
    if view.status == "missing":
        die(f"no session named '{name}'")
    s = view.payload or Sessions.load(name)
    if not s:
        die(f"session '{name}' has no local state; nothing to tear down")
    forwards = parse_forwards(s.get("FORWARDS", ""))
    match = next(((l, r) for l, r in forwards if l == args.port), None)
    if not match:
        die(f"no tracked forward on port {args.port} for session '{name}'")
    node = s.get("NODE")
    if not node:
        die(f"session '{name}' has no NODE; cannot derive forward spec")
    lport, rport = match
    try:
        ssh.cancel_forward(f"{lport}:{node}:{rport}")
    except Exception:
        pass  # best-effort, matches close_session_forwards
    remaining = [(l, r) for l, r in forwards if l != lport]
    if remaining:
        s["FORWARDS"] = format_forwards(remaining)
    else:
        s.pop("FORWARDS", None)
    Sessions.save(name, s)
    print(f"Forward down: localhost:{lport} -> {node}:{rport}")


def cmd_forward_list(args, cfg: Config) -> None:
    names = [args.name] if args.name else Sessions.list_names()
    if not names:
        print("(no tracked sessions)")
        return
    any_printed = False
    for n in names:
        s = Sessions.load(n)
        forwards = parse_forwards(s.get("FORWARDS", ""))
        if not forwards:
            continue
        any_printed = True
        node = s.get("NODE", "?")
        print(f"[{n}] node={node}")
        for lport, rport in forwards:
            print(f"  localhost:{lport} -> {node}:{rport}")
    if not any_printed:
        print("(no extra forwards)")


