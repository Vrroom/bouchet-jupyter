    import tomllib  # Python 3.11+ stdlib
except ImportError:
    try:
        import tomli as tomllib  # type: ignore[no-redef]  # pip install --user tomli
    except ImportError:
        sys.stderr.write(
            "bouchet-jupyter needs a TOML reader. On Python 3.11+ this is stdlib;\n"
            "on older Pythons run: pip install --user tomli\n"
        )
        sys.exit(1)


def toml_load(path: Path) -> dict:
    with open(path, "rb") as f:
        return tomllib.load(f)

