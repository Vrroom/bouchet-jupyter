# Tunnel subcommands
# ---------------------------------------------------------------------------

def cmd_tunnel_up(args, cfg: Config) -> None:
    name = resolve_name_for_read(args.name)
    if not Sessions.session_path(name).exists():
        die(f"no session named '{name}'; try 'bouchet-jupyter adopt' first")
    ssh = SSH(cfg.host)
    refresh_session_from_cluster(name, ssh, cfg.state_remote_dir)
    s = Sessions.load(name)
    for k in ("JOB_ID", "NODE", "PORT", "LOCAL_PORT"):
        if not s.get(k):
            die(f"session '{name}' is missing {k} — try 'bouchet-jupyter adopt --name {name}'")
    if not s.get("TOKEN"):
        die(f"jupyter not yet up for '{name}' (no TOKEN); check 'bouchet-jupyter status --name {name}'")
    if not Slurm(ssh).state(s["JOB_ID"]):
        die(f"job {s['JOB_ID']} is no longer active; "
            f"run 'bouchet-jupyter down --name {name}' to clean up")

    if args.port is not None:
        lport = args.port
        if str(lport) != s.get("LOCAL_PORT"):
            s["LOCAL_PORT"] = str(lport)
            Sessions.save(name, s)
    else:
        lport = int(s["LOCAL_PORT"])

    spec = f"{lport}:{s['NODE']}:{s['PORT']}"
    tspec_path = Sessions.tunnel_path(name)
    if tspec_path.exists():
        old_spec = tspec_path.read_text().strip()
        if old_spec and old_spec != spec:
            ssh.cancel_forward(old_spec)

    try:
        ssh.forward(spec)
    except SSHError as e:
        msg = str(e)
        if "in use" in msg or "Address already in use" in msg or "cannot listen" in msg.lower():
            die(f"local port {lport} is in use by another process; "
                f"pass --port NEW to pick a different one")
        die(f"tunnel forward failed: {msg}")
    tspec_path.write_text(spec + "\n")
    print(f"Tunnel up: localhost:{lport} -> {s['NODE']}:{s['PORT']}")
    print(f"http://localhost:{lport}/lab?token={s['TOKEN']}")


# ---------------------------------------------------------------------------
# Forward subcommands (extra port forwards on a session's node)
# ---------------------------------------------------------------------------

def _resolve_node_for_forward(name: str, args, cfg: Config, ssh: SSH) -> str:
    if args.node:
        return args.node
    s = Sessions.load(name)
    if not s.get("NODE"):
        refresh_session_from_cluster(name, ssh, cfg.state_remote_dir)
        s = Sessions.load(name)
    node = s.get("NODE")
    if not node:
        die(f"session '{name}' has no NODE yet — pass --node, or wait for the job to start")
    return node


def cmd_forward_up(args, cfg: Config) -> None:
    name = resolve_name_for_read(args.name)
    if not Sessions.session_path(name).exists():
        die(f"no session named '{name}'")
    ssh = SSH(cfg.host)
    node = _resolve_node_for_forward(name, args, cfg, ssh)
    rport = args.remote if args.remote is not None else args.port
    spec = f"{args.port}:{node}:{rport}"
    try:
        ssh.forward(spec)
    except SSHError as e:
        msg = str(e)
        if "in use" in msg or "Address already in use" in msg or "cannot listen" in msg.lower():
            die(f"local port {args.port} is in use by another process; "
                f"pass a different port")
        die(f"forward failed: {msg}")
    s = Sessions.load(name)
    forwards = [(l, r) for l, r in parse_forwards(s.get("FORWARDS", "")) if l != args.port]
    forwards.append((args.port, rport))
    s["FORWARDS"] = format_forwards(forwards)
    Sessions.save(name, s)
    print(f"Forward up: localhost:{args.port} -> {node}:{rport}  (session={name})")


def cmd_forward_down(args, cfg: Config) -> None:
    name = resolve_name_for_read(args.name)
    if not Sessions.session_path(name).exists():
        die(f"no session named '{name}'")
    s = Sessions.load(name)
    forwards = parse_forwards(s.get("FORWARDS", ""))
    match = next(((l, r) for l, r in forwards if l == args.port), None)
    if not match:
        die(f"no tracked forward on port {args.port} for session '{name}'")
    node = s.get("NODE")
    if not node:
        die(f"session '{name}' has no NODE; cannot derive forward spec")
    lport, rport = match
    SSH(cfg.host).cancel_forward(f"{lport}:{node}:{rport}")
    remaining = [(l, r) for l, r in forwards if l != lport]
    if remaining:
        s["FORWARDS"] = format_forwards(remaining)
    else:
        s.pop("FORWARDS", None)
    Sessions.save(name, s)
    print(f"Forward down: localhost:{lport} -> {node}:{rport}")


def cmd_forward_list(args, cfg: Config) -> None:
    names = [args.name] if args.name else Sessions.list_names()
    if not names:
        print("(no tracked sessions)")
        return
    any_printed = False
    for n in names:
        s = Sessions.load(n)
        forwards = parse_forwards(s.get("FORWARDS", ""))
        if not forwards:
            continue
        any_printed = True
        node = s.get("NODE", "?")
        print(f"[{n}] node={node}")
        for lport, rport in forwards:
            print(f"  localhost:{lport} -> {node}:{rport}")
    if not any_printed:
        print("(no extra forwards)")


