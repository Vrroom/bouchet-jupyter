# Slurm queries
# ---------------------------------------------------------------------------

class Slurm:
    def __init__(self, ssh: SSH):
        self.ssh = ssh

    def nodes(self) -> list["Node"]:
        out = self.ssh.run("scontrol show node -o", timeout=30)
        return [Node.parse(line) for line in out.splitlines() if line.strip()]

    def my_pending(self) -> list[dict]:
        out = self.ssh.run("squeue --me -t PD -h -o '%i|%j|%P|%R|%Q'", timeout=15)
        rows = []
        for line in out.splitlines():
            parts = line.split("|")
            if len(parts) < 5:
                continue
            rows.append({"job_id": parts[0], "name": parts[1], "partition": parts[2],
                         "reason": parts[3].strip("()"), "priority": parts[4]})
        return rows

    def start_estimate(self, job_id: str) -> dict | None:
        out = self.ssh.run(f"squeue -j {shlex.quote(job_id)} --start -h -o '%S|%R|%Q|%P'",
                           timeout=15, check=False)
        if not out.strip():
            return None
        parts = out.strip().splitlines()[0].split("|")
        if len(parts) < 4:
            return None
        return {"start": parts[0], "reason": parts[1].strip("()"),
                "priority": parts[2], "partition": parts[3]}

    def submit(self, sbatch_dir: str, sbatch_file: str, sbatch_flags: list[str],
               session_name: str, state_remote_dir: str) -> str:
        """Submit and return JOB_ID, with double-capture for race resilience.

        Also clears any legacy session.$name file before sbatch runs. Files in
        the current layout carry the job id in their name, so a leftover cannot
        be confused with this job's — but one written before that convention
        would be readable by polling before the new launcher's atomic write, and
        the laptop would tunnel to the wrong node.

        Paths (state_remote_dir / sbatch_dir) carry literal `$HOME` from config —
        keep them unquoted so the remote shell expands them. session_name is
        validated upstream (see validate_name)."""
        marker       = f"{state_remote_dir}/last-submit.{session_name}.id"
        session_file = remote_session_file(state_remote_dir, session_name)
        flags  = " ".join(shlex.quote(f) for f in sbatch_flags)
        cmd = (f"mkdir -p {state_remote_dir} && rm -f {marker} {session_file} && "
               f"cd {sbatch_dir} && "
               f"sbatch --parsable --export=ALL,JC_SESSION={shlex.quote(session_name)} "
               f"{flags} {shlex.quote(sbatch_file)} | tee {marker}")
        out = self.ssh.run(cmd, timeout=30)
        job_id = (out.strip().splitlines() or [""])[-1].strip()
        if not job_id.isdigit():
            recovered = self.ssh.run(f"cat {marker} 2>/dev/null", check=False).strip()
            if recovered.isdigit():
                job_id = recovered
        if not job_id.isdigit():
            raise SSHError(f"could not parse JOB_ID (stdout={out!r})")
        return job_id

    def cancel(self, job_id: str) -> None:
        self.ssh.run(f"scancel {shlex.quote(job_id)}", check=False)

    def state(self, job_id: str) -> str:
        return self.ssh.run(f"squeue -h -j {shlex.quote(job_id)} -o '%T %R'", check=False).strip()

    def final_state(self, job_id: str) -> str:
        return self.ssh.run(f"sacct -j {shlex.quote(job_id)} -X -P -n -o State 2>/dev/null | head -1",
                            check=False).strip()


# ---------------------------------------------------------------------------
# Node parsing
# ---------------------------------------------------------------------------

GRES_GPU_RE = re.compile(r"gpu:([A-Za-z0-9_]+):(\d+)")
ALLOC_GPU_TYPED_RE = re.compile(r"gres/gpu:([A-Za-z0-9_]+)=(\d+)")
ALLOC_GPU_TOTAL_RE = re.compile(r"gres/gpu=(\d+)")


class Node:
    """Parsed `scontrol show node -o` line."""
    __slots__ = ("name", "state", "flags", "partitions", "cpu_alloc", "cpu_tot",
                 "real_mem_mb", "alloc_mem_mb", "gpu_type", "gpu_total", "gpu_alloc")

    def __init__(self, name, state, flags, partitions, cpu_alloc, cpu_tot,
                 real_mem_mb, alloc_mem_mb, gpu_type, gpu_total, gpu_alloc):
        self.name = name
        self.state = state
        self.flags = flags
        self.partitions = partitions
        self.cpu_alloc = cpu_alloc
        self.cpu_tot = cpu_tot
        self.real_mem_mb = real_mem_mb
        self.alloc_mem_mb = alloc_mem_mb
        self.gpu_type = gpu_type
        self.gpu_total = gpu_total
        self.gpu_alloc = gpu_alloc

    @classmethod
    def parse(cls, line: str) -> "Node":
        kv: dict[str, str] = {}
        for tok in line.split():
            if "=" in tok:
                k, _, v = tok.partition("=")
                kv[k] = v
        # Compound state like MIXED+PLANNED → base + flags.
        state_raw = kv.get("State", "")
        if "+" in state_raw:
            state, _, flags = state_raw.partition("+")
        else:
            state, flags = state_raw, ""
        partitions = [p for p in kv.get("Partitions", "").split(",") if p]

        gpu_type = ""
        gpu_total = 0
        gres = kv.get("Gres", "")
        if gres and gres != "(null)":
            for match in GRES_GPU_RE.finditer(gres):
                # First gpu: line wins; multi-type per node is rare on Bouchet.
                gpu_type = match.group(1)
                gpu_total = int(match.group(2))
                break

        gpu_alloc = 0
        alloc_tres = kv.get("AllocTRES", "")
        if alloc_tres:
            tm = ALLOC_GPU_TYPED_RE.search(alloc_tres)
            if tm and (not gpu_type or tm.group(1) == gpu_type):
                gpu_alloc = int(tm.group(2))
                if not gpu_type:
                    gpu_type = tm.group(1)
            else:
                tm2 = ALLOC_GPU_TOTAL_RE.search(alloc_tres)
                if tm2:
                    gpu_alloc = int(tm2.group(1))

        return cls(
            name=kv.get("NodeName", "?"),
            state=state,
            flags=flags,
            partitions=partitions,
            cpu_alloc=int(kv.get("CPUAlloc", "0") or 0),
            cpu_tot=int(kv.get("CPUTot", "0") or 0),
            real_mem_mb=int(kv.get("RealMemory", "0") or 0),
            alloc_mem_mb=int(kv.get("AllocMem", "0") or 0),
            gpu_type=gpu_type,
            gpu_total=gpu_total,
            gpu_alloc=gpu_alloc,
        )


def fmt_mb(mb: int) -> str:
    if mb >= 1024 * 1024:
        return f"{mb / 1024 / 1024:.1f}T"
    if mb >= 1024:
        return f"{mb / 1024:.0f}G"
    return f"{mb}M"


# ---------------------------------------------------------------------------
# Sessions (local state)
# ---------------------------------------------------------------------------

class Sessions:
    @staticmethod
    def session_path(name: str) -> Path:
        return STATE_DIR / f"session.{name}"

    @staticmethod
    def tunnel_path(name: str) -> Path:
        return STATE_DIR / f"tunnel.{name}.spec"

    @staticmethod
    def list_names() -> list[str]:
        if not STATE_DIR.exists():
            return []
        names: list[str] = []
        for p in sorted(STATE_DIR.iterdir()):
            if p.name.startswith("session.") and not p.name.endswith(".spec"):
                names.append(p.name[len("session."):])
        return names

    @staticmethod
    def load(name: str) -> dict:
        p = Sessions.session_path(name)
        return parse_kv(p.read_text()) if p.exists() else {}

    @staticmethod
    def save(name: str, data: dict) -> None:
        data = {**data, "SYNCED_AT": now_epoch_str()}
        body = "\n".join(f"{k}={v}" for k, v in data.items()) + "\n"
        atomic_write_text(Sessions.session_path(name), body)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def die(msg: str, code: int = 1) -> "NoReturn":  # type: ignore[name-defined]
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def now_epoch_str() -> str:
    return str(int(time.time()))


def atomic_write_text(path: Path, body: str, *, mode: int = 0o600) -> None:
    """Write `body` to `path` via tempfile + rename so readers never see a torn file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w") as f:
            f.write(body)
        os.replace(tmp, str(path))
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def validate_name(name: str) -> str:
    if not NAME_RE.match(name):
        die(f"invalid session name {name!r} (use only letters, digits, '.', '_', '-')")
    return name


def port_in_use(p: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind(("127.0.0.1", p))
            return False
        except OSError:
            return True


def listener_description(port: int) -> str:
    """Best-effort '<command> (pid N)' for whatever listens on `port` locally.

    Empty when `ss` is unavailable or the socket belongs to another user — it
    only reports process details for sockets we own."""
    try:
        out = subprocess.run(["ss", "-ltnpH", f"sport = :{port}"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    m = re.search(r'users:\(\("([^"]+)",pid=(\d+)', out)
    return f"{m.group(1)} (pid {m.group(2)})" if m else ""


def pick_free_port(base: int, span: int = 50, *,
                   reserved: set[int] = frozenset()) -> int:
    for p in range(base, base + span):
        if p in reserved:
            continue
        if not port_in_use(p):
            return p
    die(f"no free local port in [{base},{base + span - 1}]")


def reserved_local_ports(exclude_name: str | None = None) -> set[int]:
    """LOCAL_PORTs already assigned to other tracked sessions.

    Cache-only — does not ssh. We treat any tracked session's port as taken
    even if its tunnel happens to be down right now, because that session
    will try to re-open on the same port (e.g. via `tunnel up` or `adopt`).
    """
    out: set[int] = set()
    for n in Sessions.list_names():
        if n == exclude_name:
            continue
        try:
            out.add(int(Sessions.load(n).get("LOCAL_PORT", "")))
        except (ValueError, TypeError):
            pass
    return out


# Cluster session files are named "session.<NAME>@<JOB_ID>". The job id makes a
# file left behind by a dead job unmistakable, so nothing has to guess whether a
# file describes the job we are tracking. "@" separates it because session names
# may contain "." (see NAME_RE) but never "@", so the split is unambiguous.
# Files written before this convention ("session.<NAME>") are still read; they
# carry their job id inside instead.
JOB_SEP = "@"


def remote_session_file(state_remote_dir: str, name: str, job_id: str = "") -> str:
    """Cluster path of one session file. Omitting `job_id` gives the legacy path."""
    tail = f"{JOB_SEP}{job_id}" if job_id else ""
    return f"{state_remote_dir}/session.{shlex.quote(name + tail)}"


def remote_session_patterns(state_remote_dir: str, name: str = "") -> str:
    """Shell patterns covering every session file (optionally for one name):
    the per-job files plus the legacy job-less one.

    Anchored on the "@" so that name 'default' cannot also match the files of a
    session called 'default2'."""
    if not name:
        return f"{state_remote_dir}/session.*"
    stem = f"{state_remote_dir}/session.{shlex.quote(name)}"
    return f"{stem}{JOB_SEP}* {stem}"


def parse_session_filename(basename: str) -> tuple[str, str] | None:
    """'session.<name>@<job>' -> (name, job); legacy 'session.<name>' -> (name, '').

    Returns None for anything that isn't a session file."""
    if not basename.startswith("session."):
        return None
    rest = basename[len("session."):]
    name, sep, job = rest.partition(JOB_SEP)
    return (name, job) if sep else (rest, "")


def session_file_job(job_id: str, payload: dict) -> str:
    """The job a session file describes: from its name, or from inside it when
    the file predates the per-job naming convention."""
    return job_id or payload.get("JOB_ID", "").strip()


def select_session_file(files: dict[str, dict], live_jobs: set[str],
                        local_job_id: str) -> tuple[str, dict]:
    """Pick which of a name's cluster files describes the session now.

    `files` maps the filename's job id ("" for a legacy file) to its payload.
    Preference: the job we are already tracking, then a job the cluster still
    lists, then the newest — so a leftover can never outrank a live session."""
    if not files:
        return "", {}
    if local_job_id:
        for jid, payload in files.items():
            if session_file_job(jid, payload) == local_job_id:
                return jid, payload
    live = [j for j, p in files.items() if session_file_job(j, p) in live_jobs]
    pool = live or list(files)
    newest = max(pool, key=lambda j: int(session_file_job(j, files[j]) or 0))
    return newest, files[newest]


def parse_forwards(s: str) -> list[tuple[int, int]]:
    out: list[tuple[int, int]] = []
    for tok in (s or "").split(","):
        tok = tok.strip()
        if not tok:
            continue
        l, _, r = tok.partition(":")
        try:
            out.append((int(l), int(r)))
        except ValueError:
            continue
    return out


def format_forwards(items: list[tuple[int, int]]) -> str:
    return ",".join(f"{l}:{r}" for l, r in items)


def parse_port_spec(tok: str) -> tuple[int, int]:
    """Parse a forward spec 'PORT' or 'LOCAL:REMOTE' into (lport, rport)."""
    l, _, r = tok.partition(":")
    try:
        lport = int(l)
        rport = int(r) if r else lport
    except ValueError:
        die(f"invalid port spec {tok!r} (use PORT or LOCAL:REMOTE)")
    return lport, rport


def record_forward(name: str, lport: int, rport: int) -> None:
    """Track a forward in session state, replacing any prior entry on lport."""
    s = Sessions.load(name)
    forwards = [(l, r) for l, r in parse_forwards(s.get("FORWARDS", "")) if l != lport]
    forwards.append((lport, rport))
    s["FORWARDS"] = format_forwards(forwards)
    Sessions.save(name, s)


def tracked_forward_owner(lport: int, *, exclude_tunnel_of: str | None = None
                          ) -> tuple[str, str]:
    """Which of our own sessions claims local port `lport`.

    Returns (description, command-that-frees-it); the command is empty when
    there is no targeted way to release it. `exclude_tunnel_of` skips one
    session's primary tunnel so `tunnel up` doesn't report a session as
    colliding with itself while re-opening its own port."""
    for n in Sessions.list_names():
        s = Sessions.load(n)
        for l, r in parse_forwards(s.get("FORWARDS", "")):
            if l == lport:
                return (f"the forward from session '{n}' to node port {r}",
                        f"bouchet-jupyter forward down {lport} --name {n}")
        if n != exclude_tunnel_of and (s.get("LOCAL_PORT") or "").strip() == str(lport):
            return (f"the jupyter tunnel for session '{n}'", "")
    return ("", "")


def parse_kv(blob: str) -> dict:
    out: dict = {}
    for line in (blob or "").splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            out[k.strip()] = v.strip()
    return out


def read_tunnel_spec(name: str) -> str | None:
    """Return the saved `LPORT:NODE:RPORT` for the session's primary tunnel, or None."""
    tspec = Sessions.tunnel_path(name)
    if not tspec.exists():
        return None
    return tspec.read_text().strip() or None


def parse_iso(s: str) -> datetime | None:
    try:
        return datetime.fromisoformat(s)
    except (ValueError, TypeError):
        return None


def fmt_eta(start: str) -> str:
    dt = parse_iso(start)
    if not dt:
        return "-"
    now = datetime.now(dt.tzinfo) if dt.tzinfo else datetime.now()
    delta = (dt - now).total_seconds()
    if delta < 0:
        return "now"
    h, rem = divmod(int(delta), 3600)
    m = rem // 60
    if h >= 24:
        return f"in {h // 24}d {h % 24}h"
    if h:
        return f"in {h}h {m}m"
    return f"in {m}m"


def forward_failure_reason(host: str, port: int, err: str, port_busy_hint: str,
                           exclude_tunnel_of: str | None = None) -> str:
    """Explain why `ssh -O forward` refused, since ssh itself won't say.

    The mux client hands the request to the ControlMaster, and the master keeps
    the real cause ("Address already in use", ...) on its own stderr — all that
    comes back is "Port forwarding failed". So probe the local port instead of
    pattern-matching an error string that never carries the reason."""
    # Privileged ports first: port_in_use() cannot tell "someone else has it"
    # from "this user may not bind it" — both surface as OSError on bind.
    if port < 1024 and os.geteuid() != 0:
        return (f"local port {port} is privileged (below 1024); ssh cannot bind it "
                f"as this user, so {port_busy_hint}")
    if port_in_use(port):
        who, how_to_free = tracked_forward_owner(port, exclude_tunnel_of=exclude_tunnel_of)
        if not who:
            who = listener_description(port) or "another process"
        fix = f"close it with '{how_to_free}', or {port_busy_hint}" if how_to_free \
              else port_busy_hint
        return f"local port {port} is already in use by {who}; {fix}"
    detail = err.removeprefix("tunnel forward failed: ")
    return (f"ssh refused the forward without saying why, and local port {port} is free. "
            f"The ControlMaster keeps the real reason on its own stderr; check that it is "
            f"still alive with 'ssh -O check {host}'.\n  ssh said: {detail}")


def forward_or_die(ssh: SSH, spec: str, port: int, port_busy_hint: str, *,
                   session: str | None = None) -> None:
    """Open an SSH port forward, or die explaining what actually went wrong."""
    try:
        ssh.forward(spec)
    except SSHError as e:
        die(f"forward failed: "
            f"{forward_failure_reason(ssh.host, port, str(e), port_busy_hint, session)}")


def close_session_forwards(name: str, ssh: SSH, payload: dict) -> None:
    """Cancel a session's primary tunnel and any tracked extra forwards. Best-effort."""
    spec = read_tunnel_spec(name)
    if spec:
        try:
            ssh.cancel_forward(spec)
        except Exception:
            pass
    Sessions.tunnel_path(name).unlink(missing_ok=True)
    node = payload.get("NODE")
    if node:
        for lport, rport in parse_forwards(payload.get("FORWARDS", "")):
            try:
                ssh.cancel_forward(f"{lport}:{node}:{rport}")
            except Exception:
                pass


def remove_remote_session_files(name: str, ssh: SSH, cfg: Config,
                                job_ids: list[str]) -> None:
    """Delete specific cluster-side session files for `name` (job id "" is the
    legacy job-less file). Best-effort: they are usually already gone, since the
    launcher's EXIT trap removes them, but SIGKILL / node failure bypasses it."""
    paths = [remote_session_file(cfg.state_remote_dir, name, j) for j in job_ids]
    if paths:
        ssh.run(f"rm -f {' '.join(paths)}", check=False)


def remove_all_remote_session_files(name: str, ssh: SSH, cfg: Config) -> None:
    """Delete every cluster file for `name`, both layouts. For `down`, which is
    meant to leave nothing behind."""
    ssh.run(f"rm -f {remote_session_patterns(cfg.state_remote_dir, name)}", check=False)


def push_env_file(ssh: SSH, env_cmd: str, state_remote_dir: str) -> None:
    if env_cmd:
        body = (f"# generated by bouchet-jupyter — edit ~/.config/bouchet-jupyter/"
                f"config.toml on your laptop\n{env_cmd}\n")
        ssh.run(f"mkdir -p {state_remote_dir} && cat > {state_remote_dir}/env.sh",
                input_data=body)
    else:
        ssh.run(f"rm -f {state_remote_dir}/env.sh", check=False)


def hours_to_walltime(hours: float) -> str:
    """Convert an --hours value (possibly fractional) to Slurm HH:MM:SS."""
    minutes = round(hours * 60)
    if minutes <= 0:
        die(f"--hours must be positive (got {hours:g})")
    return f"{minutes // 60:02d}:{minutes % 60:02d}:00"


def build_sbatch_flags(profile: dict) -> list[str]:
    flags: list[str] = []
    for k, prefix in (("partition", "--partition="), ("gpus", "--gpus="),
                      ("cpus", "--cpus-per-task="), ("mem", "--mem="),
                      ("time", "--time=")):
        v = profile.get(k)
        if v not in (None, ""):
            flags.append(f"{prefix}{v}")
    return flags


def resolve_name_for_read(arg_name: str | None) -> str:
    if arg_name:
        return validate_name(arg_name)
    names = Sessions.list_names()
    if not names:
        die("no tracked sessions — run 'bouchet-jupyter up' to start one, or "
            "'bouchet-jupyter adopt' if a session is already running on the cluster")
    if len(names) == 1:
        return names[0]
    die("multiple sessions tracked — pass --name <NAME>:\n  " + "\n  ".join(names))


# ---------------------------------------------------------------------------
# Session sync — cluster is the source of truth
# ---------------------------------------------------------------------------

# Slurm states that mean the job is truly done (sacct reports them).
TERMINAL_SACCT = {"COMPLETED", "FAILED", "CANCELLED", "TIMEOUT",
                   "OUT_OF_MEMORY", "PREEMPTED", "NODE_FAIL",
                   "BOOT_FAIL", "DEADLINE"}
# Squeue states that mean the job is shutting down — jupyter is going away.
WIND_DOWN_STATES = {"COMPLETING", "CG"}
# Window after submit during which squeue may not yet show the job.
SUBMIT_GRACE_S = 30
# How long a saved sync stays trusted without re-checking the cluster.
DEFAULT_FRESH_S = 5

SessionStatus = Literal["live", "launching", "winding_down",
                        "stale", "stale_unverified", "missing", "unknown"]


@dataclass
class SessionView:
    name: str
    status: SessionStatus
    payload: dict           # local merged with remote (NODE/PORT/TOKEN/JOB_ID/...)
    job_state: str | None   # raw squeue %T (e.g. "RUNNING") or None
    age_s: int              # seconds since SYNCED_AT (0 after a fresh pull)
    notes: list[str] = field(default_factory=list)
    extras: dict = field(default_factory=dict)  # display-only: elapsed/limit/reason
    remote_is_ours: bool = True                 # cluster file describes THIS job
    remote_job_file: str = ""                   # job id of the cluster file read


def local_age_s(payload: dict) -> int:
    try:
        return max(0, int(time.time()) - int(payload.get("SYNCED_AT", "0")))
    except ValueError:
        return sys.maxsize


def submitted_age_s(payload: dict) -> int | None:
    raw = payload.get("SUBMITTED_AT")
    if not raw:
        return None
    try:
        return max(0, int(time.time()) - int(raw))
    except ValueError:
        return None


def is_terminal(sacct_out: str) -> bool:
    head = (sacct_out.split() or [""])[0].rstrip("+") if sacct_out else ""
    return head in TERMINAL_SACCT


def autoclean_session(name: str, payload: dict, ssh: SSH, cfg: Config,
                      notes: list[str], *, remote_is_ours: bool = True,
                      remote_job_file: str = "") -> None:
    """Drop every trace of a session whose job has ended: forwards, local file,
    and the cluster file. Clearing the cluster file matters — leaving it behind
    lets the next command resurrect the dead session from the remote side and
    dead-end on 'stale_unverified', since the local JOB_ID needed to check
    squeue/sacct is gone."""
    close_session_forwards(name, ssh, payload)
    Sessions.session_path(name).unlink(missing_ok=True)
    if remote_is_ours:
        remove_remote_session_files(name, ssh, cfg, [remote_job_file])
    jid = payload.get("JOB_ID", "?")
    note = f"[{name}] cleaned stale (job {jid} ended)"
    if note not in notes:
        notes.append(note)


def print_notes(view: SessionView) -> None:
    for n in view.notes:
        print(n, file=sys.stderr)


def print_all_notes(views: dict[str, SessionView]) -> None:
    for v in views.values():
        print_notes(v)


def view_from_cache(name: str) -> SessionView:
    """Synthesize a SessionView from local state alone (no cluster check)."""
    local = Sessions.load(name)
    return SessionView(
        name=name,
        status="live" if local.get("TOKEN") else "launching",
        payload=local, job_state=None,
        age_s=local_age_s(local),
    )


def require_live(view: SessionView, *, fallback: str | None = None) -> None:
    """Print autoclean notes; die if the session isn't ready to use."""
    print_notes(view)
    if view.status != "live":
        die(status_message(view) or fallback or f"session '{view.name}' is not ready")


def classify_status(local: dict, remote_present: bool, remote_has_token: bool,
              remote_job_match: bool,
              squeue_state: str | None, squeue_ok: bool,
              sacct_state: str | None) -> SessionStatus:
    if not squeue_ok:
        return "unknown"
    if squeue_state in WIND_DOWN_STATES:
        return "winding_down"
    if squeue_state:
        # "live" requires the cluster file to describe THIS job. Otherwise the
        # new job's launcher hasn't yet rewritten it — keep waiting.
        return "live" if (remote_has_token and remote_job_match) else "launching"
    # squeue reports no such job (or no JOB_ID was tracked yet).
    if not local and not remote_present:
        return "missing"
    submitted_age = submitted_age_s(local)
    if submitted_age is not None and submitted_age < SUBMIT_GRACE_S and not remote_has_token:
        return "launching"
    if sacct_state and is_terminal(sacct_state):
        return "stale"
    return "stale_unverified"


def remote_job_matches(local: dict, remote: dict) -> bool:
    """True iff the remote session payload describes the same job we're tracking.

    When `local` has not yet pinned a JOB_ID (e.g. `adopt` discovering a session
    that only exists on the cluster), we trust whatever remote says. Once we've
    submitted a job, we require remote.JOB_ID to match before treating its
    NODE/PORT/TOKEN as ours — otherwise the file is a leftover from a previous
    job whose cleanup didn't fire (SIGKILL / node failure / bypassed trap)."""
    l = local.get("JOB_ID", "").strip()
    if not l:
        return True
    r = remote.get("JOB_ID", "").strip()
    return bool(r) and l == r


def remote_file_is_ours(local: dict, remote: dict) -> bool:
    """True when the cluster session file belongs to the session we're cleaning.

    A file naming a *different* JOB_ID is a newer session's (someone ran `up`
    from another machine) — deleting it would strand that session's
    NODE/PORT/TOKEN. A file naming no job at all cannot describe anything live,
    so it counts as leftover."""
    return not remote.get("JOB_ID", "").strip() or remote_job_matches(local, remote)


def merge_remote(local: dict, remote: dict) -> dict:
    """Cluster owns NODE/PORT/TOKEN/JOB_ID for the current job; local owns the rest.

    Refuses to merge when remote describes a different JOB_ID — that file is from
    a previous job and merging it would poison local state with the wrong
    NODE/PORT/TOKEN, causing a tunnel to the wrong host."""
    if not remote_job_matches(local, remote):
        return dict(local)
    payload = dict(local)
    for k in ("NODE", "PORT", "TOKEN", "JOB_ID"):
        if remote.get(k):
            payload[k] = remote[k]
    return payload


def cluster_probe_command(state_remote_dir: str, name: str = "") -> str:
    """One round trip: the session files (all, or just one name's) plus this
    user's jupyter jobs. Both sync paths issue this, so they cannot disagree
    about which file or which job state describes a session."""
    return (
        'echo ==FILES== ; '
        f'for f in {remote_session_patterns(state_remote_dir, name)} ; do '
        '  [ -e "$f" ] || continue ; '
        '  echo "==FILE==$(basename "$f")" ; '
        '  cat "$f" ; '
        'done ; '
        'echo ==SQUEUE== ; '
        'squeue --me --name=jupyter -h -o "%i|%T|%R|%M|%l|%N" 2>/dev/null'
    )


@dataclass
class ClusterSnapshot:
    """One round trip's worth of cluster truth."""
    files: dict[str, dict[str, dict]] = field(default_factory=dict)  # name -> job id -> payload
    live_jobs: dict[str, str] = field(default_factory=dict)          # job id -> squeue state
    live_extras: dict[str, dict] = field(default_factory=dict)       # job id -> display fields
    ok: bool = True

    @staticmethod
    def fetch(ssh: SSH, cfg: Config, name: str = "") -> "ClusterSnapshot":
        try:
            out = ssh.run(cluster_probe_command(cfg.state_remote_dir, name),
                          check=False, retry=True)
        except SSHError:
            return ClusterSnapshot(ok=False)
        files_block, _, squeue_block = out.partition("==SQUEUE==")
        snap = ClusterSnapshot(files=parse_files_block(files_block))
        snap.live_jobs, snap.live_extras = parse_squeue_block(squeue_block)
        return snap


def parse_files_block(block: str) -> dict[str, dict[str, dict]]:
    """'==FILE==<basename>' sections -> {session name: {file job id: payload}}."""
    out: dict[str, dict[str, dict]] = {}
    cur: tuple[str, str] | None = None
    lines: list[str] = []

    def flush() -> None:
        if cur is not None:
            out.setdefault(cur[0], {})[cur[1]] = parse_kv("\n".join(lines))

    for line in block.splitlines():
        if line.startswith("==FILES=="):
            continue
        if line.startswith("==FILE=="):
            flush()
            cur = parse_session_filename(line[len("==FILE=="):].strip())
            lines = []
        elif cur is not None:
            lines.append(line)
    flush()
    return out


def parse_squeue_block(block: str) -> tuple[dict[str, str], dict[str, dict]]:
    """squeue '%i|%T|%R|%M|%l|%N' rows -> (job id -> state, job id -> extras)."""
    live_jobs: dict[str, str] = {}
    live_extras: dict[str, dict] = {}
    for line in (block or "").splitlines():
        parts = line.split("|")
        if len(parts) >= 2 and parts[0].strip().isdigit():
            jid = parts[0].strip()
            live_jobs[jid] = parts[1].strip()
            extra: dict = {}
            for key, idx in (("reason", 2), ("elapsed", 3), ("limit", 4), ("node", 5)):
                if len(parts) > idx:
                    extra[key] = parts[idx].strip().strip("()") if key == "reason" \
                                 else parts[idx].strip()
            live_extras[jid] = extra
    return live_jobs, live_extras


def probe_from_snapshot(name: str, snap: ClusterSnapshot, slurm: Slurm) -> ClusterProbe:
    """Judge one session against a snapshot: which file is current, and how its
    job looks. Local JOB_ID is authoritative — it's what we submitted; without
    one (adopt of a cluster-only session) the file's own job id is used."""
    local_job_id = Sessions.load(name).get("JOB_ID", "").strip()
    file_job, remote = select_session_file(snap.files.get(name, {}),
                                           set(snap.live_jobs), local_job_id)
    job_id = local_job_id or session_file_job(file_job, remote)
    sq_state = snap.live_jobs.get(job_id) if job_id else None
    sacct_state: str | None = None
    if snap.ok and job_id and not sq_state:
        try:
            sacct_state = slurm.final_state(job_id)
        except SSHError:
            sacct_state = None
    return ClusterProbe(remote=remote, sq_state=sq_state, sacct_state=sacct_state,
                        extras=snap.live_extras.get(job_id, {}) if job_id else {},
                        squeue_ok=snap.ok, remote_job_file=file_job)


def sweep_dead_session_files(name: str, snap: ClusterSnapshot, keep: str,
                             ssh: SSH, cfg: Config) -> None:
    """Remove this name's per-job files whose job the cluster no longer lists.

    The launcher's trap normally deletes its own file; a SIGKILLed job leaves
    one behind. Per-job names mean a leftover can't shadow a live session, but
    it would pile up forever, so drop it once its job is out of the queue."""
    doomed = [j for j, payload in snap.files.get(name, {}).items()
              if j and j != keep and session_file_job(j, payload) not in snap.live_jobs]
    if doomed:
        remove_remote_session_files(name, ssh, cfg, doomed)


# Laptop-side preferences, not job state: they survive a session being replaced
# by a newer job on the cluster. SUBMITTED_AT deliberately isn't here — carrying
# it would make the new job look like it is still inside the submit grace window.
CARRY_ON_RECHECK = ("LOCAL_PORT", "PROFILE")


@dataclass
class ClusterProbe:
    """What the cluster says about one session right now."""
    remote: dict                          # parsed cluster session file
    sq_state: str | None = None           # squeue %T for the job we're tracking
    sacct_state: str | None = None        # sacct final state, when squeue has none
    extras: dict = field(default_factory=dict)
    squeue_ok: bool = True
    remote_job_file: str = ""             # job id of the file read ("" = legacy layout)


@dataclass
class Settled:
    """Outcome of judging one session against the cluster."""
    status: SessionStatus
    payload: dict
    probe: ClusterProbe
    remote_is_ours: bool
    notes: list[str] = field(default_factory=list)


def settle_session(name: str, probe_cluster: Callable[[], ClusterProbe],
                   ssh: SSH, cfg: Config, *, autoclean: bool) -> Settled:
    """Classify one session, autocleaning it when its job has ended.

    `probe_cluster()` re-reads local state each time it is called, so a second
    call after an autoclean sees the session the way a fresh command would."""
    notes: list[str] = []
    carried: dict = {}
    for attempt in (1, 2):
        local = {**carried, **Sessions.load(name)}
        probe = probe_cluster()
        remote = probe.remote
        status = classify_status(local, bool(remote), bool(remote.get("TOKEN")),
                           remote_job_matches(local, remote),
                           probe.sq_state, probe.squeue_ok, probe.sacct_state)
        payload = merge_remote(local, remote)
        remote_is_ours = remote_file_is_ours(local, remote)
        if status == "stale" and autoclean and (local or remote):
            autoclean_session(name, payload, ssh, cfg, notes,
                              remote_is_ours=remote_is_ours,
                              remote_job_file=probe.remote_job_file)
            payload = {}
            # A dead local record can mask a *newer* job: an `up` from another
            # machine leaves a cluster file naming a job this laptop never
            # tracked, and the dead record is what we just classified. With it
            # gone, judge the session on that file alone rather than reporting
            # "stale" and making the user run the same command twice. Laptop-side
            # preferences outlive the job they were recorded against, so carry
            # them into the re-check instead of re-picking a local port.
            if attempt == 1 and local and remote and not remote_is_ours:
                carried = {k: local[k] for k in CARRY_ON_RECHECK if local.get(k)}
                continue
        elif status in ("live", "launching") and (local or remote):
            Sessions.save(name, payload)
            payload = Sessions.load(name)
        return Settled(status=status, payload=payload, probe=probe,
                       remote_is_ours=remote_is_ours, notes=notes)


def sync_one(name: str, ssh: SSH, slurm: Slurm, cfg: Config,
             *, max_age_s: int = DEFAULT_FRESH_S,
             autoclean: bool = True) -> SessionView:
    local = Sessions.load(name)
    age = local_age_s(local)
    if local and "JOB_ID" in local and age < max_age_s:
        return SessionView(
            name=name,
            status="live" if local.get("TOKEN") else "launching",
            payload=local, job_state=None, age_s=age,
        )

    # Re-fetch on each call: settle_session may clean state between attempts,
    # and the second look has to see the cluster as a fresh command would.
    def probe_cluster() -> ClusterProbe:
        return probe_from_snapshot(name, ClusterSnapshot.fetch(ssh, cfg, name), slurm)

    r = settle_session(name, probe_cluster, ssh, cfg, autoclean=autoclean)
    return SessionView(name=name, status=r.status, payload=r.payload,
                       job_state=r.probe.sq_state,
                       age_s=0 if r.probe.squeue_ok else age,
                       notes=r.notes, extras=r.probe.extras,
                       remote_is_ours=r.remote_is_ours,
                       remote_job_file=r.probe.remote_job_file)


def sync_all(ssh: SSH, slurm: Slurm, cfg: Config,
             *, autoclean: bool = True) -> dict[str, SessionView]:
    snap = ClusterSnapshot.fetch(ssh, cfg)
    names = set(Sessions.list_names()) | set(snap.files)
    views: dict[str, SessionView] = {}
    for n in sorted(names):
        age = local_age_s(Sessions.load(n))
        r = settle_session(n, lambda n=n: probe_from_snapshot(n, snap, slurm),
                           ssh, cfg, autoclean=autoclean)
        if autoclean and snap.ok:
            sweep_dead_session_files(n, snap, r.probe.remote_job_file, ssh, cfg)
        views[n] = SessionView(name=n, status=r.status, payload=r.payload,
                               job_state=r.probe.sq_state,
                               age_s=0 if snap.ok else age,
                               notes=r.notes, extras=r.probe.extras,
                               remote_is_ours=r.remote_is_ours,
                               remote_job_file=r.probe.remote_job_file)
    return views


def status_message(view: SessionView) -> str:
    """Single-line explanation of why a non-live status is non-live."""
    n = view.name
    jid = view.payload.get("JOB_ID", "?")
    if view.status == "live":
        return ""
    if view.status == "launching":
        return (f"session '{n}' is still launching (jupyter not yet up); "
                f"check 'bouchet-jupyter status --name {n}'")
    if view.status == "winding_down":
        return (f"session '{n}' is winding down (job {jid} {view.job_state}); "
                f"wait for it to finish, then 'bouchet-jupyter up --name {n}'")
    if view.status == "stale":
        return (f"session '{n}' is no longer running and has been cleaned up; "
                f"'bouchet-jupyter up --name {n}' to start a new one")
    if view.status == "stale_unverified":
        return (f"session '{n}': job {jid} is not in squeue but sacct didn't "
                f"confirm a terminal state — 'bouchet-jupyter down --name {n}' "
                f"to clean up if it's truly gone")
    if view.status == "missing":
        return f"no session named '{n}' (run 'bouchet-jupyter up --name {n}' to create one)"
    return f"could not reach the cluster to verify '{n}'; using cached state"


# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

def cmd_up(args, cfg: Config) -> None:
    name    = validate_name(args.name or "default")
    profile = args.profile or cfg.default_profile

    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)

    pre = sync_one(name, ssh, slurm, cfg, max_age_s=0)
    print_notes(pre)
    if pre.status == "live":
        die(f"session '{name}' is already running (job {pre.payload.get('JOB_ID','?')}); "
            f"use 'bouchet-jupyter url --name {name}' or 'tunnel up --name {name}'")
    if pre.status == "launching":
        die(f"session '{name}' is already launching (job {pre.payload.get('JOB_ID','?')}); "
            f"wait, or 'bouchet-jupyter down --name {name}' first")
    if pre.status == "winding_down":
        die(f"session '{name}' is winding down (job {pre.payload.get('JOB_ID','?')}); "
            f"wait for it to clear, then re-run 'up'")
    if pre.status == "stale_unverified":
        die(f"session '{name}': job {pre.payload.get('JOB_ID','?')} is not in squeue but "
            f"sacct didn't confirm — 'bouchet-jupyter down --name {name}' first")
    if pre.status == "unknown":
        die("could not reach the cluster — check ssh connectivity")
    # 'stale' has been auto-cleaned; 'missing' is the green path. Both proceed.

    resolved  = cfg.resolve_profile(profile)
    if args.hours is not None:
        resolved["time"] = hours_to_walltime(args.hours)
    base_port = args.port or cfg.local_port
    lport     = pick_free_port(base_port, reserved=reserved_local_ports(exclude_name=name))

    print("Syncing env to cluster...")
    push_env_file(ssh, cfg.env_cmd, cfg.state_remote_dir)

    flags = build_sbatch_flags(resolved)
    print(f"Submitting job (profile={profile}, name={name})...")
    job_id = slurm.submit(cfg.sbatch_dir, cfg.sbatch_file, flags, name, cfg.state_remote_dir)
    Sessions.save(name, {"JOB_ID": job_id, "PROFILE": profile,
                         "LOCAL_PORT": str(lport),
                         "SUBMITTED_AT": now_epoch_str()})
    print(f"  job {job_id}  flags: {' '.join(flags) or '<sbatch defaults>'}  local_port={lport}")

    print("Waiting for jupyter to start (Ctrl-C to stop waiting)...")
    delay = POLL_START
    last_state = ""
    try:
        while True:
            view = sync_one(name, ssh, slurm, cfg, max_age_s=0, autoclean=False)
            if view.status == "live":
                break
            if view.status in ("stale", "winding_down"):
                notes: list[str] = []
                autoclean_session(name, view.payload, ssh, cfg, notes,
                                  remote_is_ours=view.remote_is_ours,
                                  remote_job_file=view.remote_job_file)
                for note in notes:
                    print(note, file=sys.stderr)
                die(f"  job {job_id} left the queue ({view.status}) — aborting")
            if view.status == "unknown":
                pass  # transient ssh failure; keep polling
            elif view.job_state and view.job_state != last_state:
                print(f"  {view.job_state}")
                last_state = view.job_state
            time.sleep(delay)
            delay = min(int(delay * 2), POLL_MAX)
    except KeyboardInterrupt:
        print()
        print(f"interrupted — job {job_id} still queued. "
              f"Run \"bouchet-jupyter down --name {name}\" to scancel.")
        raise SystemExit(130)

    s = Sessions.load(name)
    print(f"  node={s['NODE']} port={s['PORT']}")
    # The port was picked before submit, possibly hours ago — something else may
    # have taken it while we waited. Move rather than fail with the job running.
    if port_in_use(lport):
        moved = pick_free_port(base_port, reserved=reserved_local_ports(exclude_name=name))
        print(f"  local port {lport} was taken while the job started; using {moved}")
        lport = moved
        s["LOCAL_PORT"] = str(lport)
        Sessions.save(name, s)
        s = Sessions.load(name)
    spec = f"{lport}:{s['NODE']}:{s['PORT']}"
    print(f"Opening tunnel localhost:{lport} -> {s['NODE']}:{s['PORT']} via {cfg.host}...")
    forward_or_die(ssh, spec, lport,
                   f"the job is running — reconnect with "
                   f"'bouchet-jupyter tunnel up --name {name} --port NEW'",
                   session=name)
    atomic_write_text(Sessions.tunnel_path(name), spec + "\n")

    url = f"http://localhost:{lport}/lab?token={s['TOKEN']}"
    print()
    print(f"  {url}")
    print()
    for opener in ("open", "xdg-open"):
        if subprocess.run(["which", opener], capture_output=True).returncode == 0:
            subprocess.run([opener, url], capture_output=True)
            break


def down_one(name: str, ssh: SSH, cfg: Config, payload: dict) -> None:
    """Tear a session down. `payload` must come from a sync, not a bare
    Sessions.load(): a session that lives only on the cluster has no local file,
    and its JOB_ID would be invisible here."""
    s = payload
    close_session_forwards(name, ssh, s)
    Sessions.session_path(name).unlink(missing_ok=True)
    if s.get("JOB_ID"):
        Slurm(ssh).cancel(s["JOB_ID"])
        print(f"[{name}] scancelled {s['JOB_ID']}")
    remove_all_remote_session_files(name, ssh, cfg)
    print(f"[{name}] tunnel down")


def cmd_down(args, cfg: Config) -> None:
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    if args.all:
        views = sync_all(ssh, slurm, cfg)
        print_all_notes(views)
        # Iterate what the sync returned, not Sessions.list_names(): a session
        # that exists only on the cluster has no local file to enumerate, and
        # the ones already autocleaned above come back with an empty payload.
        targets = {n: v for n, v in views.items() if v.payload}
        if not targets:
            print("(no tracked sessions)")
            return
        for n in sorted(targets):
            down_one(n, ssh, cfg, targets[n].payload)
        return
    name = validate_name(args.name or "default")
    view = sync_one(name, ssh, slurm, cfg, max_age_s=0)
    print_notes(view)
    if view.status == "missing":
        die(f"no session named '{name}'")
    if view.status == "stale":
        # autoclean ran inside sync_one
        return
    if view.status == "unknown":
        die("could not reach the cluster — check ssh connectivity")
    down_one(name, ssh, cfg, view.payload)


def print_list_rows(views: dict[str, SessionView]) -> None:
    rows = [v for v in views.values() if v.payload]
    if not rows:
        print("(no tracked sessions)")
        return
    lport_owners: dict[str, list[str]] = {}
    for v in rows:
        lp = v.payload.get("LOCAL_PORT")
        if lp:
            lport_owners.setdefault(lp, []).append(v.name)
    for lp, names in lport_owners.items():
        if len(names) > 1:
            print(f"warning: LOCAL_PORT {lp} is shared by {', '.join(names)} — "
                  f"only one tunnel can bind it; run 'tunnel up --name <other> --port <free>'",
                  file=sys.stderr)
    print(f"{'NAME':<12} {'PROFILE':<7} {'JOB_ID':<10} {'STATE':<14} {'NODE':<14} "
          f"{'LPORT':<6} {'RPORT':<6} ELAPSED/LIMIT")
    for v in sorted(rows, key=lambda x: x.name):
        s = v.payload
        jid = s.get("JOB_ID", "?")
        node = s.get("NODE") or v.extras.get("node", "-")
        elapsed = v.extras.get("elapsed", "-")
        limit   = v.extras.get("limit", "-")
        # Display a single STATE token combining squeue state + our status.
        if v.status == "live":
            state = v.job_state or "RUNNING"
        elif v.status == "launching":
            state = v.job_state or "LAUNCHING"
        elif v.status == "winding_down":
            state = v.job_state or "COMPLETING"
        else:
            state = v.status.upper()
        print(f"{v.name:<12} {s.get('PROFILE','?'):<7} {jid:<10} {state:<14} "
              f"{node:<14} {s.get('LOCAL_PORT','?'):<6} {s.get('PORT','-'):<6} "
              f"{elapsed}/{limit}")


def cmd_list(args, cfg: Config) -> None:
    if getattr(args, "no_sync", False):
        views = {n: view_from_cache(n) for n in sorted(Sessions.list_names())}
        print_list_rows(views)
        return
    ssh = SSH(cfg.host)
    views = sync_all(ssh, Slurm(ssh), cfg)
    print_all_notes(views)
    print_list_rows(views)


def cmd_status(args, cfg: Config) -> None:
    if not args.name:
        cmd_list(args, cfg)
        return
    name = validate_name(args.name)
    if getattr(args, "no_sync", False):
        view = view_from_cache(name)
        if not view.payload:
            die(f"no session named '{name}'")
    else:
        ssh = SSH(cfg.host)
        view = sync_one(name, ssh, Slurm(ssh), cfg, max_age_s=DEFAULT_FRESH_S)
        print_notes(view)
    if view.status == "missing":
        die(f"no session named '{name}'")
    s = view.payload
    for k in ("JOB_ID", "PROFILE", "LOCAL_PORT", "NODE", "PORT", "TOKEN",
              "FORWARDS", "SUBMITTED_AT", "SYNCED_AT"):
        if k in s:
            print(f"{k}={s[k]}")
    print()
    if view.status == "live":
        print(f"job {s['JOB_ID']}: {view.job_state or 'RUNNING'}  (jupyter ready)")
    elif view.status == "launching":
        print(f"job {s.get('JOB_ID','?')}: {view.job_state or 'pending'}  (jupyter not yet up)")
    else:
        msg = status_message(view)
        if msg:
            print(msg)


def cmd_url(args, cfg: Config) -> None:
    name = resolve_name_for_read(args.name)
    ssh  = SSH(cfg.host)
    view = sync_one(name, ssh, Slurm(ssh), cfg, max_age_s=DEFAULT_FRESH_S)
    require_live(view)
    if not view.payload.get("TOKEN"):
        die(status_message(view) or f"session '{name}' has no TOKEN yet")
    s = view.payload
    lport = s.get("LOCAL_PORT")
    if not lport:
        die(f"session '{name}' has no LOCAL_PORT recorded; "
            f"run 'bouchet-jupyter tunnel up --name {name}' first")
    # Compare the whole spec, not just the local port: a session that moved to a
    # new node keeps its port, and a tunnel to the old node would look fine here
    # while pointing nowhere.
    spec = read_tunnel_spec(name)
    want = f"{lport}:{s.get('NODE','')}:{s.get('PORT','')}"
    if spec != want:
        die(f"session '{name}': no live tunnel to {s.get('NODE','?')}:{s.get('PORT','?')} "
            f"on port {lport} (tunnel.spec {'missing' if not spec else 'has ' + spec}); "
            f"run 'bouchet-jupyter tunnel up --name {name}'")
    print(f"http://localhost:{lport}/lab?token={s['TOKEN']}")


def cmd_logs(args, cfg: Config) -> None:
