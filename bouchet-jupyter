def cmd_forward_up(args, cfg: Config) -> None:
    pairs = [parse_port_spec(tok) for tok in args.ports]
    if args.remote is not None:
        if len(pairs) > 1:
            die("--remote works with a single PORT; use LOCAL:REMOTE pairs for multiple")
        if ":" in args.ports[0]:
            die(f"--remote conflicts with {args.ports[0]!r}; pass one or the other")
        pairs = [(pairs[0][0], args.remote)]
    seen: set[int] = set()
    for lport, _ in pairs:
        if lport in seen:
            die(f"local port {lport} given more than once")
        seen.add(lport)

    name  = resolve_name_for_read(args.name)
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    view  = sync_one(name, ssh, slurm, cfg, max_age_s=DEFAULT_FRESH_S)
    require_live(view)
    s = view.payload
    node = args.node or s.get("NODE")
    if not node:
        die(f"session '{name}' has no NODE — pass --node, or wait for the job to start")
    # Record after each successful forward so a failure partway through still
    # leaves the already-open ones tracked (and torn down later by `down`).
    for lport, rport in pairs:
        spec = f"{lport}:{node}:{rport}"
        forward_or_die(ssh, spec, lport,
                       f"pick a free local port instead: "
                       f"'bouchet-jupyter forward up {lport + 1}:{rport}'")
        record_forward(name, lport, rport)
        print(f"Forward up: localhost:{lport} -> {node}:{rport}  (session={name})")


def cmd_forward_down(args, cfg: Config) -> None:
    name  = resolve_name_for_read(args.name)
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    view  = sync_one(name, ssh, slurm, cfg, max_age_s=DEFAULT_FRESH_S)
    print_notes(view)
    if view.status == "missing":
        die(f"no session named '{name}'")
    s = view.payload or Sessions.load(name)
    if not s:
        die(f"session '{name}' has no local state; nothing to tear down")
    forwards = parse_forwards(s.get("FORWARDS", ""))
    by_lport = dict(forwards)
    ports = list(dict.fromkeys(args.ports))
    unknown = [p for p in ports if p not in by_lport]
    if unknown:
        die(f"no tracked forward on port(s) {', '.join(str(p) for p in unknown)} "
            f"for session '{name}'")
    node = s.get("NODE")
    if not node:
        die(f"session '{name}' has no NODE; cannot derive forward spec")
    for lport in ports:
        rport = by_lport[lport]
        try:
            ssh.cancel_forward(f"{lport}:{node}:{rport}")
        except Exception:
            pass  # best-effort, matches close_session_forwards
        print(f"Forward down: localhost:{lport} -> {node}:{rport}")
    remaining = [(l, r) for l, r in forwards if l not in set(ports)]
    if remaining:
        s["FORWARDS"] = format_forwards(remaining)
    else:
        s.pop("FORWARDS", None)
    Sessions.save(name, s)


def cmd_forward_list(args, cfg: Config) -> None:
    # Sync first: NODE comes from the cluster, and printing a forward against a
    # node the session no longer runs on is worse than one extra round trip.
    ssh   = SSH(cfg.host)
    views = sync_all(ssh, Slurm(ssh), cfg)
    print_all_notes(views)
    names = [args.name] if args.name else sorted(views)
    if not names:
        print("(no tracked sessions)")
        return
    any_printed = False
    for n in names:
        s = views[n].payload if n in views else Sessions.load(n)
        forwards = parse_forwards(s.get("FORWARDS", ""))
        if not forwards:
            continue
        any_printed = True
        node = s.get("NODE", "?")
        print(f"[{n}] node={node}")
        for lport, rport in forwards:
            print(f"  localhost:{lport} -> {node}:{rport}")
    if not any_printed:
        print("(no extra forwards)")


