def cmd_tunnel_up(args, cfg: Config) -> None:
    name  = resolve_name_for_read(args.name)
    ssh   = SSH(cfg.host)
    slurm = Slurm(ssh)
    view  = sync_one(name, ssh, slurm, cfg, max_age_s=0)
    require_live(view)
    s = view.payload
    if not s.get("LOCAL_PORT"):
        s["LOCAL_PORT"] = str(pick_free_port(
            cfg.local_port, reserved=reserved_local_ports(exclude_name=name)))
        Sessions.save(name, s)
        s = Sessions.load(name)

    if args.port is not None:
        lport = args.port
        if lport in reserved_local_ports(exclude_name=name):
            die(f"port {lport} is already assigned to another tracked session; "
                f"pass a different --port or 'down' the other one first")
    else:
        lport = int(s["LOCAL_PORT"])

    spec = f"{lport}:{s['NODE']}:{s['PORT']}"
    old_spec = read_tunnel_spec(name)
    if old_spec:
        # Always cancel the previous forward (cancel_forward is idempotent), so
        # `tunnel up` can re-open a tunnel that ssh's mux still thinks exists.
        ssh.cancel_forward(old_spec)

    forward_or_die(ssh, spec, lport, "pass --port NEW to pick a different one",
                   session=name)
    atomic_write_text(Sessions.tunnel_path(name), spec + "\n")
    if str(lport) != s.get("LOCAL_PORT"):
        s["LOCAL_PORT"] = str(lport)
        Sessions.save(name, s)
    print(f"Tunnel up: localhost:{lport} -> {s['NODE']}:{s['PORT']}")
    print(f"http://localhost:{lport}/lab?token={s['TOKEN']}")


